// Channels: how fibers talk (docs/design/fibers.md). A channel carries VALUES between
// fibers — each send deep-copies the value to the shared heap, so what the receiver gets
// owes nothing to the sender's own memory and outlives the sender entirely. The channel
// itself is a shared handle: a spawned fiber that captures one speaks through the same
// channel, not a copy of it.
//
//     fn consumer(ch: Channel[i64]) {
//         while channel::recv(ch) is i64 as n {
//             io::println("got #{n}");
//         }
//     }
//
//     fn main() {
//         fiber::runtime(() => {
//             let ch: Channel[i64] = channel::new();
//             fiber::spawn(() => consumer(ch));
//             try! channel::send(ch, 1);
//             try! channel::send(ch, 2);
//             channel::close(ch);
//         });
//     }
//
// Sends never block (the buffer grows); a receive blocks the calling FIBER — not the
// thread — until a value arrives, and returns `null` once the channel is closed and
// drained, which is how a consumer loop ends. Sending on a closed channel throws
// ClosedError — catchable, and with a guarantee worth leaning on: a send that threw did
// NOT send, so the caller still owns the value (for a resource, the baton never left).
//
// What can cross: anything except a capturing closure — scalars, strings, lists, maps,
// records, unions, boxed `any`, channels themselves (a channel in a message is the same
// channel on both sides, not a copy), and RESOURCES. A resource in a message is a
// TRANSFER: the receiver becomes its owner, the sender's bindings go stale and throw
// NotOwnerError on use (std::resource). A value containing a capturing closure still
// traps at the send with a message saying so.

/// The channel type: a shared, refcounted handle. Two bindings to one channel are the same
/// channel; equality is identity.
@runtime("neon_channel_ref") sealed opaque record Channel[T] {}

/// A fresh open channel. Sends never block (the buffer grows without limit); use `bounded`
/// when the producer must not outrun the consumer.
@native("neon_channel_new") fn new[T]() -> Channel[T]

/// A channel that holds at most `n` undelivered values: a send onto a full channel blocks
/// THIS FIBER until a receive drains one — backpressure, so a fast producer is paced by its
/// consumer instead of growing memory without bound. `n` must be at least 1.
@native("neon_channel_new_bounded") fn bounded[T](n: i64) -> Channel[T]

/// Sending on a channel someone closed. Catchable: the classic race is a producer still
/// sending while the consumer decides it is done, and a program should get to react.
record ClosedError { message: str }
impl Error for ClosedError { fn message(v: ClosedError) -> str { v.message } }

internal mod raw {
    /// False when the channel is (or, for a parked bounded send, becomes) closed — the
    /// copy never ran on that path, so the value was untouched.
    @native("neon_channel_send") fn send[T](ch: Channel[T], v: T) -> bool
}

/// Send `v`: deep-copy it to the shared heap, hand it to a waiting receiver (waking it)
/// or buffer it. Blocks this fiber only on a full `bounded` channel. Throws ClosedError
/// on a closed channel — and a throw means NOT sent: the caller still owns `v`, and a
/// resource's baton stayed home.
fn send[T](ch: Channel[T], v: T) throws ClosedError {
    if !raw::send(ch, v) {
        throw ClosedError { message: "send on a closed channel" };
    };
}

/// Receive the next value, blocking this fiber while the channel is open and empty.
/// Returns `null` only once the channel is both closed and drained:
///
///     while channel::recv(ch) is i64 as n { ... }
@native("neon_channel_recv") fn recv[T](ch: Channel[T]) -> T | null

/// Close the channel: every parked receiver wakes with `null`, later receives drain the
/// buffer then return `null`, and later sends throw ClosedError (a send already blocked
/// on a full bounded channel wakes and throws — it can never complete, and its value was
/// never taken). Idempotent.
@native("neon_channel_close") fn close[T](ch: Channel[T])

/// Whether the channel has been closed. A `null` from `recv` already means closed AND
/// drained; this answers the sharper "will more values ever arrive" — after a
/// `recv_timeout` came back `null`, say.
@native("neon_channel_is_closed") fn is_closed[T](ch: Channel[T]) -> bool

/// Receive with a deadline: a value, or `null` once the channel is closed and drained OR
/// after `millis` with nothing arriving — `is_closed` tells the two apart when it matters.
@native("neon_channel_recv_timeout") fn recv_timeout[T](ch: Channel[T], millis: i64) -> T | null

/// Receive from whichever of several channels is ready first: block this fiber until one
/// channel in `channels` hands over a value or is closed-and-drained, take from exactly that
/// one, and leave the rest untouched. Returns the winning channel's index into `channels`
/// paired with what it yielded — a value, or `null` when that channel was closed:
///
///     let (i, v) = channel::select_recv([left, right]);
///     if v is i64 as n { io::println("channel #{i} -> #{n}"); }
///     else { io::println("channel #{i} closed"); }
///
/// Among channels ALREADY ready at the call, a value beats a closed channel and ties go to
/// the lowest index — so a closed channel never masks data already waiting, and that choice
/// is deterministic. Once this fiber parks (nothing was ready), the winner is simply
/// whichever channel acts first, a real-time race like every select; a value already
/// present, though, was taken before the park and never loses to a later close. Traps on
/// an empty list — a select with nothing to wait on could only hang.
///
/// v1 is receive-only and requires every channel to carry the same element type `T`; a
/// send-select and a heterogeneous select (which would need union machinery to say which
/// type came back) are follow-ups. `select_recv_timeout` — the same with a deadline — is the
/// natural next step: the runtime already parks on deadlines for `recv_timeout`.
@native("neon_channel_select_recv") fn select_recv[T](channels: List[Channel[T]]) -> (i64, T | null)
