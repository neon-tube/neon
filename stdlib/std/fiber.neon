// Fibers: stackful, cooperatively-scheduled green threads (docs/design/fibers.md). A fiber
// that blocks looks like an ordinary call — no `async`, no coloring — and each fiber has its
// own isolated heap, so a crash in one kills that fiber and the rest carry on.
//
// The runtime is lazy: nothing exists until `fiber::runtime(body)` runs `body` as the first
// fiber and returns when it and everything it transitively spawned have finished. `spawn`
// enqueues another fiber under the running scheduler; `yield` hands the CPU to the next ready
// fiber and returns when it comes back around.
//
//     fn worker() {
//         io::println("working");
//         fiber::yield();
//         io::println("done");
//     }
//
//     fn main() {
//         fiber::runtime(() => {
//             fiber::spawn(worker);
//             fiber::spawn(worker);
//         });
//     }
//
// `spawn` takes any `() -> ()` — a named function or a lambda, capturing or not. Captured
// values cross to the new fiber by DEEP COPY (each capture follows the sendability rules —
// see std::channel; a captured resource traps with a message saying so), and a captured
// channel is the same channel on both sides, which is how fibers usually meet.

use std::sys;

/// Run `body` as the first fiber and pump until every fiber — `body` and everything it
/// transitively spawned — has finished. Call it once, from outside a runtime; nesting one
/// inside a running fiber traps.
///
/// The scheduler gets one seat per core (`sys::core_count()`), because a fiber's isolation
/// makes using them safe and leaving them idle only makes the program slower. That means
/// fibers run in PARALLEL by default, so the order in which independent fibers interleave
/// is not deterministic — make ordering a property of the DATA (a channel, a task) rather
/// than of the schedule. Where a program genuinely needs one seat — a deterministic test,
/// or code that must not run concurrently at all — say so with `runtime_on(1, body)`.
fn runtime(body: () -> ()) {
    runtime_on(sys::core_count(), body)
}

/// As `runtime`, with exactly `threads` seats. 1 is a single-threaded, deterministic
/// scheduler; anything more pins fibers across that many OS threads at spawn.
@native("neon_fiber_lang_runtime_threads") fn runtime_on(threads: i64, body: () -> ())

/// Enqueue `body` to run as a new fiber under the running scheduler. Traps if no runtime is
/// active. The new fiber runs when the scheduler next reaches it, not immediately.
@native("neon_fiber_lang_spawn") fn spawn(body: () -> ())

/// Yield cooperatively: the scheduler runs the other ready fibers, then this one again.
/// Traps outside a fiber.
@native("neon_fiber_sched_yield") fn yield()


