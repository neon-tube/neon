// Numbers.
//
// `f64` keeps IEEE semantics here as everywhere else in the language: nothing traps and
// nothing throws. `sqrt(-1.0)` is NaN, `1.0 / 0.0` is infinity, and a caller who cares
// asks with `is_nan`/`is_infinite`. That is the same answer `==` and `<` already give for
// NaN -- see "Comparison is structural" in docs/decisions.md.
//
// `i64` is the opposite, and stays so: `abs(min_i64)` has no representable answer, so it
// traps exactly as division by zero does. Two types, two contracts, each stated.
//
// There is no overloading, so the two `abs` are two names.

/// π, to f64 precision -- the ratio of a circle's circumference to its diameter.
const PI: f64 = 3.141592653589793
/// e, to f64 precision -- the base of the natural logarithm.
const E: f64 = 2.718281828459045

@pure @native("neon_f64_sqrt") fn sqrt(x: f64) -> f64
@pure @native("neon_f64_pow") fn pow(base: f64, exp: f64) -> f64
@pure @native("neon_f64_floor") fn floor(x: f64) -> f64
@pure @native("neon_f64_ceil") fn ceil(x: f64) -> f64
@pure @native("neon_f64_round") fn round(x: f64) -> f64
@pure @native("neon_f64_abs") fn abs(x: f64) -> f64
@pure @native("neon_f64_is_nan") fn is_nan(x: f64) -> bool
@pure @native("neon_f64_is_infinite") fn is_infinite(x: f64) -> bool

/// Natural log. `ln(0.0)` is negative infinity and `ln` of a negative is NaN -- IEEE,
/// like everything else here. The name is `ln`, not `log`: half the languages mean
/// base-e by `log` and half mean base-10, and a name both camps misread is worse than
/// one neither uses loosely.
@pure @native("neon_f64_ln") fn ln(x: f64) -> f64
@pure @native("neon_f64_log10") fn log10(x: f64) -> f64
@pure @native("neon_f64_exp") fn exp(x: f64) -> f64

/// Radians, as libm. Degrees are `d * math::PI / 180.0` at the call site.
@pure @native("neon_f64_sin") fn sin(x: f64) -> f64
@pure @native("neon_f64_cos") fn cos(x: f64) -> f64
@pure @native("neon_f64_tan") fn tan(x: f64) -> f64
/// The angle of the point `(x, y)`, in radians, `y` FIRST -- C's argument order, kept
/// because inverting a fifty-year convention would be a trap for anyone arriving from it.
@pure @native("neon_f64_atan2") fn atan2(y: f64, x: f64) -> f64

/// The smaller of two floats. Unlike `cmp::min`, which orders structurally and would
/// answer NaN questions with `<`'s always-false, these follow libm: one NaN yields the
/// OTHER operand -- NaN as "no data", not poison -- and both-NaN yields NaN.
@pure @native("neon_f64_min") fn min(a: f64, b: f64) -> f64
@pure @native("neon_f64_max") fn max(a: f64, b: f64) -> f64

/// `x` forced into `[lo, hi]`. `lo > hi` answers `hi`, as the composition runs; a NaN `x`
/// comes back `lo` -- min and max both discard it -- which is a defensible answer for
/// "force this into range" and the caller who disagrees tests `is_nan` first.
fn clamp(x: f64, lo: f64, hi: f64) -> f64 {
    min(max(x, lo), hi)
}

/// `a` forced into `[lo, hi]`. Two names for two types, as with `abs`/`abs_int`.
fn clamp_int(a: i64, lo: i64, hi: i64) -> i64 {
    if a < lo { lo } else if hi < a { hi } else { a }
}

/// Traps on `min_i64`, whose negation is not an i64.
@pure @native("neon_i64_abs") fn abs_int(a: i64) -> i64

/// Exact only up to 2^53; beyond that it rounds, as in every language with both types.
@pure @native("neon_i64_to_f64") fn to_f64(a: i64) -> f64

/// Truncates toward zero. Traps on NaN or a value outside the i64 range, where the C cast
/// would otherwise be undefined.
@pure @native("neon_f64_to_i64") fn to_int(x: f64) -> i64
