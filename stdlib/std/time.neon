// Two clocks and a pause, and a civil calendar over the wall clock. No `Instant` and no
// `Duration`: without methods or operator overloading those types are ceremony around an
// integer, and the protection that matters — never measuring with the wall clock — lives
// in the NAMES here instead.

use std::string;

/// Nanoseconds from an arbitrary origin. Differences mean something; the value itself
/// means nothing, and it never goes backwards. This is the measuring clock:
///
///     let began = time::monotonic();
///     work();
///     let took_ms = (time::monotonic() - began) / 1000000;
@native("neon_time_monotonic") fn monotonic() -> i64

/// Milliseconds since 1970-01-01T00:00:00Z — the calendar. It can jump either direction
/// when the machine's clock is set, which is why it is not the measuring clock.
@native("neon_time_unix_millis") fn unix_millis() -> i64

/// Block for at least `millis`. At least: the OS wakes the process no sooner, and
/// somewhat later under load. `millis <= 0` returns at once.
@native("neon_time_sleep") fn sleep(millis: i64)

// ---- the civil calendar (UTC) ----
//
// A `DateTime` is a proleptic-Gregorian instant in UTC, and every conversion here is pure
// integer arithmetic — Howard Hinnant's `days_from_civil`/`civil_from_days` (correct for
// the full range, not just an epoch window). No libc `gmtime`/`localtime`: those keep
// static state and are neither reentrant nor fiber-safe, and the whole point of a green
// thread is that it can be moved between OS threads mid-call. `now()` reads one native —
// `unix_millis` — and does the rest in Neon, so it is as fiber-safe as an integer add.
//
// UTC only. There is no timezone database and no `local_offset`: a real one is a data
// file and a parser, and half a timezone layer is worse than none. Offsets in an RFC 3339
// string are honoured on the way IN (the instant is unambiguous); everything held and
// emitted is UTC, marked `Z`.

const MILLIS_PER_SECOND: i64 = 1000
const MILLIS_PER_MINUTE: i64 = 60000
const MILLIS_PER_HOUR: i64 = 3600000
const MILLIS_PER_DAY: i64 = 86400000

/// A wall-clock instant in UTC, broken into calendar fields. `month` is 1..=12 and `day`
/// is 1..=31; `hour` 0..=23, `minute`/`second` 0..=59, `millis` 0..=999. The fields are
/// the storage — there is no hidden epoch value — so a `DateTime` you build by hand is as
/// real as one from `now`, and only as valid as the numbers you put in it. `from_unix_millis`
/// is the way to get fields that are guaranteed consistent.
record DateTime {
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    minute: i64,
    second: i64,
    millis: i64,
}

/// Just the calendar day, when the clock is noise: a birthday, a ledger date, the `date`
/// half of a `DateTime`. Same field contract as `DateTime`'s date part.
record Date {
    year: i64,
    month: i64,
    day: i64,
}

/// A timestamp that would not parse. Carries the reason, not the position — the input is
/// short and the message names what was expected.
record ParseError { message: str }
impl Display for ParseError { fn to_string(v: ParseError) -> str { v.message } }
impl Error for ParseError { fn message(v: ParseError) -> str { v.message } }

/// The date part, dropping the time of day.
fn to_date(dt: DateTime) -> Date {
    Date { year: dt.year, month: dt.month, day: dt.day }
}

// The two Hinnant conversions and the sign-correct division they need. Kept internal:
// the useful currency outside this module is milliseconds and `DateTime`, not a raw day
// count, and exposing the day number would invite arithmetic that belongs in millis.
internal mod raw {
    /// Floor division for a POSITIVE divisor — `/` truncates toward zero, which splits a
    /// negative dividend the wrong way (a millisecond before the epoch belongs to the day
    /// before, not the day after). Every divisor below is a positive constant.
    fn fdiv(a: i64, b: i64) -> i64 {
        let q = a / b;
        if a % b < 0 { q - 1 } else { q }
    }

    /// The non-negative remainder to match `fdiv`: result in `0..b`.
    fn fmod(a: i64, b: i64) -> i64 {
        let r = a % b;
        if r < 0 { r + b } else { r }
    }

    /// Days since 1970-01-01 for a proleptic-Gregorian `y-m-d`. The ternaries are not
    /// stylistic: they are what makes the flooring correct under C's truncating `/`, so
    /// leave them exactly as written (Hinnant, "chrono-Compatible Low-Level Date Algorithms").
    fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
        let y = if m <= 2 { y0 - 1 } else { y0 };
        let era = if y >= 0 { y / 400 } else { (y - 399) / 400 };
        let yoe = y - era * 400;
        let mp = if m > 2 { m - 3 } else { m + 9 };
        let doy = (153 * mp + 2) / 5 + d - 1;
        let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        era * 146097 + doe - 719468
    }

    /// The inverse: `(year, month, day)` for a day count since 1970-01-01.
    fn civil_from_days(z0: i64) -> (i64, i64, i64) {
        let z = z0 + 719468;
        let era = if z >= 0 { z / 146097 } else { (z - 146096) / 146097 };
        let doe = z - era * 146097;
        let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        let y = yoe + era * 400;
        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        let mp = (5 * doy + 2) / 153;
        let d = doy - (153 * mp + 2) / 5 + 1;
        let m = if mp < 10 { mp + 3 } else { mp - 9 };
        (if m <= 2 { y + 1 } else { y }, m, d)
    }
}

/// Milliseconds since 1970-01-01T00:00:00Z for a `DateTime`, read as UTC. The exact inverse
/// of `from_unix_millis` for any in-range value; out-of-range fields (month 13, day 40)
/// roll over rather than throwing — build with the parser or the constructors if you need
/// the fields validated.
fn to_unix_millis(dt: DateTime) -> i64 {
    let days = raw::days_from_civil(dt.year, dt.month, dt.day);
    let tod = dt.hour * MILLIS_PER_HOUR
        + dt.minute * MILLIS_PER_MINUTE
        + dt.second * MILLIS_PER_SECOND
        + dt.millis;
    days * MILLIS_PER_DAY + tod
}

/// The `DateTime` for a unix-millis instant, in UTC. Negative values (before 1970) decompose
/// correctly — the day-of and time-of-day come out non-negative even for a millisecond a
/// hair before the epoch.
fn from_unix_millis(ms: i64) -> DateTime {
    let days = raw::fdiv(ms, MILLIS_PER_DAY);
    let tod = raw::fmod(ms, MILLIS_PER_DAY);
    let (y, m, d) = raw::civil_from_days(days);
    DateTime {
        year: y,
        month: m,
        day: d,
        hour: tod / MILLIS_PER_HOUR,
        minute: tod / MILLIS_PER_MINUTE % 60,
        second: tod / MILLIS_PER_SECOND % 60,
        millis: tod % MILLIS_PER_SECOND,
    }
}

/// The current UTC wall-clock time. Reads `unix_millis` and converts in Neon, so it is
/// fiber-safe where libc's `gmtime` is not. Like `unix_millis`, it can jump when the
/// machine's clock is set — measure durations with `monotonic`, not with this.
fn now() -> DateTime {
    from_unix_millis(unix_millis())
}

/// `dt` shifted by `ms` milliseconds (negative goes back). Carries across every boundary —
/// month ends, year ends, leap days — because it round-trips through the millis line rather
/// than touching the fields.
fn add_millis(dt: DateTime, ms: i64) -> DateTime {
    from_unix_millis(to_unix_millis(dt) + ms)
}

/// Milliseconds from `b` to `a`, i.e. `a - b`. Positive when `a` is the later instant.
fn diff_millis(a: DateTime, b: DateTime) -> i64 {
    to_unix_millis(a) - to_unix_millis(b)
}

// ---- ISO 8601 / RFC 3339 ----

internal mod fmt {
    /// `n` as a decimal string left-padded with zeros to at least `width`. Non-negative
    /// callers only — every field it formats is.
    fn pad(n: i64, width: i64) -> str {
        let out = to_string(n);
        while string::byte_len(out) < width {
            out = string::concat("0", out);
        };
        out
    }
}

/// RFC 3339 / ISO 8601, always UTC and always with milliseconds and the `Z`:
/// `2026-08-11T14:03:09.123Z`. The year is padded to four digits, which covers 0..=9999 —
/// the sub-range every real timestamp lives in; a year outside it prints its natural
/// digits, still parseable but no longer a fixed-width field.
fn format_iso(dt: DateTime) -> str {
    "#{fmt::pad(dt.year, 4)}-#{fmt::pad(dt.month, 2)}-#{fmt::pad(dt.day, 2)}T#{fmt::pad(dt.hour, 2)}:#{fmt::pad(dt.minute, 2)}:#{fmt::pad(dt.second, 2)}.#{fmt::pad(dt.millis, 3)}Z"
}

impl Display for DateTime {
    fn to_string(dt: DateTime) -> str { format_iso(dt) }
}

impl Display for Date {
    fn to_string(d: Date) -> str {
        "#{fmt::pad(d.year, 4)}-#{fmt::pad(d.month, 2)}-#{fmt::pad(d.day, 2)}"
    }
}

internal mod parse {
    /// `string::slice`, but its `IndexError` becomes a `ParseError` — so the whole parser's
    /// only failure type is `ParseError`. A slice past the end is just a short timestamp.
    fn sub(s: str, from: i64, to: i64) throws ParseError -> str {
        try string::slice(s, from, to) catch (e) {
            throw ParseError { message: "timestamp is too short" }
        }
    }

    /// The digits in `[from, to)` as a number, or a `ParseError` if any byte there is not an
    /// ASCII digit or the field runs off the end. Strict: no sign, no space, no leniency —
    /// a timestamp is fixed-width and anything else is malformed.
    fn field(s: str, from: i64, to: i64) throws ParseError -> i64 {
        let digits = try sub(s, from, to);
        try string::to_int(digits) catch (e) {
            throw ParseError { message: "expected digits, found `#{digits}`" }
        }
    }

    /// Require the single byte at `at` to equal `want`.
    fn sep(s: str, at: i64, want: str) throws ParseError {
        let got = try sub(s, at, at + 1);
        if got != want {
            throw ParseError { message: "expected `#{want}`, found `#{got}`" };
        }
    }

    fn is_digit(c: str) -> bool {
        c >= "0" and c <= "9" and string::byte_len(c) == 1
    }
}

/// Parse an RFC 3339 timestamp into a UTC `DateTime`. Accepts `2026-08-11T14:03:09Z` and
/// `...09.123Z`; the fractional second may be any length and is read to millisecond
/// precision (further digits are dropped, truncating). A trailing `Z` OR a numeric
/// `+HH:MM`/`-HH:MM` offset is required — a naive timestamp with no zone is ambiguous, so
/// it throws rather than guessing UTC. An offset is applied on the way in and the result is
/// the equivalent UTC instant. Field ranges are checked (month 1..=12, hour 0..=23, …) but
/// not day-against-month — `2026-02-31` parses, and `to_unix_millis` will roll it into March.
fn parse_iso(s: str) throws ParseError -> DateTime {
    try parse::sep(s, 4, "-");
    try parse::sep(s, 7, "-");
    try parse::sep(s, 10, "T");
    try parse::sep(s, 13, ":");
    try parse::sep(s, 16, ":");
    let year = try parse::field(s, 0, 4);
    let month = try parse::field(s, 5, 7);
    let day = try parse::field(s, 8, 10);
    let hour = try parse::field(s, 11, 13);
    let minute = try parse::field(s, 14, 16);
    let second = try parse::field(s, 17, 19);

    // The tail after the seconds is an optional `.fraction` then the mandatory zone.
    let len = string::byte_len(s);
    let after_frac = if len > 19 and (try parse::sub(s, 19, 20)) == "." {
        let i = 20;
        while i < len and parse::is_digit(try parse::sub(s, i, i + 1)) {
            i = i + 1;
        };
        i
    } else {
        19
    };
    let millis = if after_frac > 20 {
        // Normalise the fraction to exactly three digits: pad short, truncate long.
        let frac = try parse::sub(s, 20, after_frac);
        let three = if string::byte_len(frac) >= 3 {
            try parse::sub(frac, 0, 3)
        } else {
            let p = frac;
            while string::byte_len(p) < 3 { p = string::concat(p, "0"); };
            p
        };
        try string::to_int(three) catch (e) {
            throw ParseError { message: "bad fractional second" }
        }
    } else {
        0
    };

    if month < 1 or month > 12 { throw ParseError { message: "month out of range" }; };
    if day < 1 or day > 31 { throw ParseError { message: "day out of range" }; };
    if hour > 23 { throw ParseError { message: "hour out of range" }; };
    if minute > 59 { throw ParseError { message: "minute out of range" }; };
    if second > 59 { throw ParseError { message: "second out of range" }; };

    let dt = DateTime {
        year: year, month: month, day: day,
        hour: hour, minute: minute, second: second, millis: millis,
    };

    // The zone. `Z` is UTC; an offset means the fields are local, so subtract it to reach
    // UTC. Anything else — a missing zone included — is a malformed instant.
    let zone = try parse::sub(s, after_frac, len);
    if zone == "Z" {
        dt
    } else {
        let sign = if string::starts_with(zone, "+") {
            1
        } else if string::starts_with(zone, "-") {
            -1
        } else {
            throw ParseError { message: "missing time zone (`Z` or `+HH:MM`)" }
        };
        if string::byte_len(zone) != 6 { throw ParseError { message: "malformed offset" }; };
        try parse::sep(zone, 3, ":");
        let oh = try parse::field(zone, 1, 3);
        let om = try parse::field(zone, 4, 6);
        if oh > 23 or om > 59 { throw ParseError { message: "offset out of range" }; };
        let offset = sign * (oh * MILLIS_PER_HOUR + om * MILLIS_PER_MINUTE);
        from_unix_millis(to_unix_millis(dt) - offset)
    }
}
