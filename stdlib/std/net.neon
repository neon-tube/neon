// Sockets — `net::tcp`, `net::udp` and `net::tls`.
//
// The point of this module, and the reason it sits on top of fibers: **an ordinary blocking
// call is the concurrent one.** `tcp::read` blocks its caller and nothing else. On a fiber
// that means the fiber parks and its thread goes on serving every other connection; on
// `main` it means an ordinary blocking read. There is no `async`, no colour, and no second
// copy of the API for the concurrent case — the same few lines are a toy client and the
// inner loop of a server.
//
//     fn echo(c: tcp::Stream) {
//         let msg = try! tcp::read(c, 4096);
//         while msg != "" {
//             try! tcp::write(c, msg);
//             msg = try! tcp::read(c, 4096);
//         };
//     }
//
//     fn main() {
//         let l = try! tcp::listen(":8080");
//         fiber::runtime(() => { try! tcp::serve(l, echo) });
//     }
//
// That server handles connections concurrently across every core, and nothing in `echo`
// knows it.
//
// An ADDRESS is text: `host:port`, with an IPv6 host in brackets — `"[::1]:8080"` — so the
// colon before the port is unambiguous. A name works wherever a literal does (resolution is
// `getaddrinfo`), an empty host means every interface (`":8080"`), and port `0` takes any
// free port, which `local_addr` then reports — how a test avoids fighting over a fixed one.
//
// A handle is a `Resource`: the socket closes when the last reference dies even if a `throw`
// skipped the explicit `close`, and if a fiber CRASHES holding one the teardown walk closes
// it. Use-after-close is a diagnosable error rather than a read of a descriptor number that
// has since been reused.

use std::fiber;
use std::resource;
use std::io::IoError;

/// A failure in the TLS layer itself — a handshake that would not complete, a certificate
/// that would not verify, a missing trust store, a broken record stream. Plain socket
/// failures stay `IoError`; the split matters because a TlsError usually means the OTHER
/// side (or the operator's certificates) needs fixing, not the network.
record TlsError { message: str }
impl Error for TlsError { fn message(v: TlsError) -> str { v.message } }

internal mod raw {
    @native("neon_net_listen") fn listen(addr: str, backlog: i64) -> i64
    /// The connected descriptor, and the peer's address: the tuple's tail is a C
    /// out-parameter.
    @native("neon_net_accept") fn accept(fd: i64) -> (i64, str)
    @native("neon_net_connect") fn connect(addr: str) -> i64
    @native("neon_net_read") fn read(fd: i64, max: i64) -> (str, i64)
    @native("neon_net_write") fn write(fd: i64, parts: List[str]) -> i64
    @native("neon_net_close") fn close(fd: i64) -> i64
    @native("neon_net_shutdown") fn shutdown(fd: i64, how: i64) -> i64
    @native("neon_net_local_addr") fn local_addr(fd: i64) -> (str, i64)
    @native("neon_net_set_nodelay") fn set_nodelay(fd: i64, on: bool) -> i64
    @native("neon_net_udp_bind") fn udp_bind(addr: str) -> i64
    @native("neon_net_udp_send_to") fn udp_send_to(fd: i64, addr: str, data: str) -> i64
    /// The datagram, the sender's address, and the status.
    @native("neon_net_udp_recv_from") fn udp_recv_from(fd: i64, max: i64) -> (str, str, i64)
    @native("neon_io_strerror") fn strerror(code: i64) -> str

    /// The TLS natives (runtime/src/tls.c). The handshake three own the descriptor they
    /// are handed — failure closes it — and report failure as a pre-rendered message in
    /// the tuple's tail, because the interesting causes (an unverifiable certificate, a
    /// missing trust store) are not errnos and their detail is only readable inside the
    /// native. Read and write return mbedTLS codes; `tls_strerror` renders those.
    @native("neon_tls_client") fn tls_client(fd: i64, host: str, verify: bool) -> (i64, str)
    @native("neon_tls_listen_config") fn tls_listen_config(cert: str, key: str) -> (i64, str)
    @native("neon_tls_accept") fn tls_accept(cfg: i64, fd: i64) -> (i64, str)
    @native("neon_tls_read") fn tls_read(h: i64, max: i64) -> (str, i64)
    @native("neon_tls_write") fn tls_write(h: i64, data: str) -> i64
    @native("neon_tls_close") fn tls_close(h: i64) -> i64
    @native("neon_tls_config_free") fn tls_config_free(cfg: i64) -> i64
    @native("neon_tls_strerror") fn tls_strerror(code: i64) -> str

    fn fail(code: i64, what: str) throws IoError {
        throw IoError { message: "#{what}: #{strerror(code)}" };
    }
}

/// Connection-oriented sockets.
mod tcp {
    /// A listening socket.
    sealed record Listener { r: resource::Resource[i64, IoError] }

    /// One connection.
    sealed record Stream { r: resource::Resource[i64, IoError] }

    /// Which half of a connection to shut down.
    type Half = :read | :write | :both

    // The guards live in one place so no path can produce a handle that closes differently
    // — or not at all.
    internal mod guard {
        fn listener(fd: i64) -> Listener {
            Listener { r: resource::new(fd, (d: i64) => { raw::close(d); }) }
        }
        fn stream(fd: i64) -> Stream {
            Stream { r: resource::new(fd, (d: i64) => { raw::close(d); }) }
        }
    }

    fn listener_fd(l: Listener) throws IoError -> i64 {
        try resource::get(l.r) catch (e) {
            throw IoError { message: "this listener is closed" }
        }
    }

    fn stream_fd(s: Stream) throws IoError -> i64 {
        try resource::get(s.r) catch (e) {
            throw IoError { message: "this socket is closed" }
        }
    }

    /// Bind and listen. `":8080"` listens on every interface; `"127.0.0.1:0"` takes any free
    /// port, which `local_addr` will then report.
    fn listen(addr: str) throws IoError -> Listener {
        let fd = raw::listen(addr, 128);
        if fd < 0 {
            try raw::fail(fd, "cannot listen on `#{addr}`");
        };
        guard::listener(fd)
    }

    /// Wait for a connection. Blocks this fiber, not the thread.
    fn accept(l: Listener) throws IoError -> Stream {
        let (fd, peer) = raw::accept(try listener_fd(l));
        if fd < 0 {
            try raw::fail(fd, "cannot accept");
        };
        guard::stream(fd)
    }

    /// As `accept`, also reporting who connected.
    fn accept_from(l: Listener) throws IoError -> (Stream, str) {
        let (fd, peer) = raw::accept(try listener_fd(l));
        if fd < 0 {
            try raw::fail(fd, "cannot accept");
        };
        (guard::stream(fd), peer)
    }

    /// Connect, waiting for the handshake.
    fn connect(addr: str) throws IoError -> Stream {
        let fd = raw::connect(addr);
        if fd < 0 {
            try raw::fail(fd, "cannot connect to `#{addr}`");
        };
        guard::stream(fd)
    }

    /// Up to `max` bytes, waiting until some arrive. An EMPTY result means the peer closed
    /// its end — the loop condition for reading a stream to its end:
    ///
    ///     let chunk = try tcp::read(s, 4096);
    ///     while chunk != "" { ...; chunk = try tcp::read(s, 4096); }
    fn read(s: Stream, max: i64) throws IoError -> str {
        let (data, code) = raw::read(try stream_fd(s), max);
        if code < 0 {
            try raw::fail(code, "cannot read");
        };
        data
    }

    /// Every byte, waiting whenever the socket buffer fills. A stream socket may accept a
    /// write only partially; this loops until it is all out, so a short write is never the
    /// caller's problem.
    fn write(s: Stream, data: str) throws IoError {
        let code = raw::write(try stream_fd(s), [data]);
        if code < 0 {
            try raw::fail(code, "cannot write");
        };
    }

    /// As `write`, for several pieces at once — they reach the kernel without being
    /// concatenated first.
    fn write_all(s: Stream, parts: List[str]) throws IoError {
        let code = raw::write(try stream_fd(s), parts);
        if code < 0 {
            try raw::fail(code, "cannot write");
        };
    }

    /// Close now rather than when the handle dies. Optional — the guard closes it either
    /// way — and closing twice is a no-op.
    fn close(s: Stream) throws IoError {
        try resource::release(s.r);
    }

    fn close_listener(l: Listener) throws IoError {
        try resource::release(l.r);
    }

    /// Half-close: `:write` says "I have sent everything" while leaving this side able to
    /// read the reply, which is how a request/response exchange over a stream ends without
    /// ambiguity.
    fn shutdown(s: Stream, half: Half) throws IoError {
        let how = if half == :read { 0 } else if half == :write { 1 } else { 2 };
        let code = raw::shutdown(try stream_fd(s), how);
        if code < 0 {
            try raw::fail(code, "cannot shut down");
        };
    }

    /// The address a listener is bound to — how one on port `0` learns its port.
    fn local_addr(l: Listener) throws IoError -> str {
        let (addr, code) = raw::local_addr(try listener_fd(l));
        if code < 0 {
            try raw::fail(code, "cannot read the local address");
        };
        addr
    }

    /// The local address of a connection.
    fn stream_addr(s: Stream) throws IoError -> str {
        let (addr, code) = raw::local_addr(try stream_fd(s));
        if code < 0 {
            try raw::fail(code, "cannot read the local address");
        };
        addr
    }

    /// Nagle off: send small writes immediately instead of waiting to coalesce them. What a
    /// request/response protocol wants; a bulk transfer is better off without it.
    fn set_nodelay(s: Stream, on: bool) throws IoError {
        let code = raw::set_nodelay(try stream_fd(s), on);
        if code < 0 {
            try raw::fail(code, "cannot set nodelay");
        };
    }

    /// Accept forever, running `handler` on its own fiber per connection — the shape of
    /// every server, so that a slow client blocks only itself. Returns only by throwing,
    /// which is why its return type is `never`.
    ///
    /// This is an ordinary loop anyone could write — that sentence used to be false, and
    /// making it true is what resource ownership was built for. `move` hands the accepted
    /// connection's baton to its handler fiber, so the resource that closes a connection
    /// belongs to the fiber that uses it: a crashed handler still closes its socket, and
    /// this loop's own binding goes stale the moment it spawns. `handler` still crosses
    /// per fiber, so it must be a named function or capture-free lambda; a handler
    /// needing state should receive it over a channel.
    fn serve(l: Listener, handler: (Stream) -> ()) throws IoError -> never {
        while true {
            let c = try accept(l);
            fiber::spawn(move () => { handler(c); });
        };
        throw IoError { message: "unreachable: the accept loop ended without failing" }
    }
}

/// Datagram sockets. Connectionless: every send names its destination, every receive
/// reports its sender.
mod udp {
    sealed record Socket { r: resource::Resource[i64, IoError] }

    internal mod guard {
        fn socket(fd: i64) -> Socket {
            Socket { r: resource::new(fd, (d: i64) => { raw::close(d); }) }
        }
    }

    fn socket_fd(u: Socket) throws IoError -> i64 {
        try resource::get(u.r) catch (e) {
            throw IoError { message: "this socket is closed" }
        }
    }

    /// Bind a datagram socket. `":9000"` binds every interface; `"127.0.0.1:0"` takes any
    /// free port.
    fn bind(addr: str) throws IoError -> Socket {
        let fd = raw::udp_bind(addr);
        if fd < 0 {
            try raw::fail(fd, "cannot bind `#{addr}`");
        };
        guard::socket(fd)
    }

    /// One datagram to `addr`. Returns the bytes sent — a datagram goes whole or not at
    /// all, so there is no partial-send loop to write.
    fn send_to(u: Socket, addr: str, data: str) throws IoError -> i64 {
        let n = raw::udp_send_to(try socket_fd(u), addr, data);
        if n < 0 {
            try raw::fail(n, "cannot send to `#{addr}`");
        };
        n
    }

    /// One datagram and its sender's address, waiting for one to arrive. A datagram longer
    /// than `max` is TRUNCATED and the rest discarded — that is UDP's semantics, so size the
    /// buffer for the largest message the protocol allows.
    fn recv_from(u: Socket, max: i64) throws IoError -> (str, str) {
        let (data, peer, code) = raw::udp_recv_from(try socket_fd(u), max);
        if code < 0 {
            try raw::fail(code, "cannot receive");
        };
        (data, peer)
    }

    fn close(u: Socket) throws IoError {
        try resource::release(u.r);
    }

    fn local_addr(u: Socket) throws IoError -> str {
        let (addr, code) = raw::local_addr(try socket_fd(u));
        if code < 0 {
            try raw::fail(code, "cannot read the local address");
        };
        addr
    }
}

/// Encrypted streams — TLS over `tcp`, mbedTLS underneath (runtime/src/tls.c). The same
/// blocking-is-concurrent story as everything above: a handshake or a read parks its
/// fiber, not its thread, because mbedTLS's transport callbacks wait on the very seam
/// `tcp::read` waits on. Certificates are VERIFIED BY DEFAULT — full chain against the
/// OS trust store, hostname included — and the opt-out is a separate function with
/// `insecure` in its name, so a grep finds every place a program decided not to check.
mod tls {
    /// A listening socket plus the certificate chain and private key it answers with.
    sealed record Listener {
        l: resource::Resource[i64, IoError],
        cfg: resource::Resource[i64, IoError],
    }

    /// One encrypted connection. Reads hand back decrypted bytes; writes encrypt. The
    /// handle is a resource exactly like `tcp::Stream` — cleanup (close_notify, free,
    /// close) runs when the owning ref dies, crash included, and it crosses fibers by
    /// `move` like any other owned identity.
    sealed record Stream { r: resource::Resource[i64, IoError] }

    internal mod guard {
        fn stream(h: i64) -> Stream {
            Stream { r: resource::new(h, (d: i64) => { raw::tls_close(d); }) }
        }
        fn listener(fd: i64, cfg: i64) -> Listener {
            Listener {
                l: resource::new(fd, (d: i64) => { raw::close(d); }),
                cfg: resource::new(cfg, (c: i64) => { raw::tls_config_free(c); }),
            }
        }
    }

    fn listener_fd(l: Listener) throws IoError -> i64 {
        try resource::get(l.l) catch (e) {
            throw IoError { message: "this listener is closed" }
        }
    }

    fn listener_cfg(l: Listener) throws IoError -> i64 {
        try resource::get(l.cfg) catch (e) {
            throw IoError { message: "this listener is closed" }
        }
    }

    fn stream_handle(s: Stream) throws IoError -> i64 {
        try resource::get(s.r) catch (e) {
            throw IoError { message: "this stream is closed" }
        }
    }

    /// Connect and handshake, verifying the peer's certificate chain against the OS trust
    /// store and its name against `host`. `host` is also what SNI announces, and it is a
    /// separate argument because `addr` may be a raw IP while the certificate names a
    /// domain. Failure to verify — or to find a trust store at all — is a `TlsError`,
    /// never a silent downgrade.
    fn connect(addr: str, host: str) throws IoError | TlsError -> Stream {
        let fd = raw::connect(addr);
        if fd < 0 {
            try raw::fail(fd, "cannot connect to `#{addr}`");
        };
        let (h, msg) = raw::tls_client(fd, host, true);
        if h < 0 {
            throw TlsError { message: msg };
        };
        guard::stream(h)
    }

    /// As `connect`, but WITHOUT verifying who is on the other end — the connection is
    /// encrypted against a passive reader and nothing more; an active peer can be anyone.
    /// For self-signed development certificates and tests. The name is the warning.
    fn connect_insecure(addr: str, host: str) throws IoError | TlsError -> Stream {
        let fd = raw::connect(addr);
        if fd < 0 {
            try raw::fail(fd, "cannot connect to `#{addr}`");
        };
        let (h, msg) = raw::tls_client(fd, host, false);
        if h < 0 {
            throw TlsError { message: msg };
        };
        guard::stream(h)
    }

    /// Bind and listen, answering handshakes with the certificate chain and private key
    /// in the two PEM files. Both are read and parsed HERE, so a bad path or a garbled
    /// key fails at the line the operator wrote it on, not at the first client.
    fn listen(addr: str, cert_pem_path: str, key_pem_path: str) throws IoError | TlsError -> Listener {
        let (cfg, msg) = raw::tls_listen_config(cert_pem_path, key_pem_path);
        if cfg < 0 {
            throw TlsError { message: msg };
        };
        let fd = raw::listen(addr, 128);
        if fd < 0 {
            raw::tls_config_free(cfg);
            try raw::fail(fd, "cannot listen on `#{addr}`");
        };
        guard::listener(fd, cfg)
    }

    /// Wait for a connection and complete the server-side handshake. Blocks this fiber,
    /// not the thread. A client that fails its handshake (a scanner, a plain-HTTP
    /// misdial) throws — an accept loop that should survive those catches the TlsError
    /// and goes around again.
    fn accept(l: Listener) throws IoError | TlsError -> Stream {
        let (fd, peer) = raw::accept(try listener_fd(l));
        if fd < 0 {
            try raw::fail(fd, "cannot accept");
        };
        let (h, msg) = raw::tls_accept(try listener_cfg(l), fd);
        if h < 0 {
            throw TlsError { message: msg };
        };
        guard::stream(h)
    }

    /// Up to `max` decrypted bytes, waiting until some arrive. An empty result means the
    /// peer closed — `tcp::read`'s contract, one layer up.
    fn read(s: Stream, max: i64) throws IoError | TlsError -> str {
        let (data, code) = raw::tls_read(try stream_handle(s), max);
        if code < 0 {
            throw TlsError { message: "cannot read: #{raw::tls_strerror(code)}" };
        };
        data
    }

    /// Every byte, encrypted, waiting whenever the socket buffer fills.
    fn write(s: Stream, data: str) throws IoError | TlsError {
        let code = raw::tls_write(try stream_handle(s), data);
        if code < 0 {
            throw TlsError { message: "cannot write: #{raw::tls_strerror(code)}" };
        };
    }

    /// Close now — close_notify to the peer, then the descriptor — rather than when the
    /// handle dies. Optional, and closing twice is a no-op.
    fn close(s: Stream) throws IoError {
        try resource::release(s.r);
    }

    fn close_listener(l: Listener) throws IoError {
        try resource::release(l.l);
        try resource::release(l.cfg);
    }

    /// The address a listener is bound to — how one on port `0` learns its port.
    fn local_addr(l: Listener) throws IoError -> str {
        let (addr, code) = raw::local_addr(try listener_fd(l));
        if code < 0 {
            try raw::fail(code, "cannot read the local address");
        };
        addr
    }
}
