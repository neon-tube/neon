// Eager transformation over a one-parameter container `C[_]`. Every method returns a fresh
// `C` (or, for `fold`, the accumulated value): the language is immutable, so there is
// nothing lazy to thread and no iterator to allocate. A two-parameter type like
// `Map[K, V]` is not a functor over one parameter, so it iterates through
// `map::values`/`map::keys` first. See docs/design/stdlib.md.
//
// The impl below is not an orphan: this module declares `List` and owns the protocol.
// The list itself: nominal, covariant in `T`, and opaque -- the storage is native, so
// there is nothing to expose and nothing a caller could correctly build. Declared here
// rather than in the prelude so that THIS module owns it: opacity is decided by the
// declaring module's subtree, and the prelude's path is the root, which every program
// shares. See docs/design/opacity.md.
use std::map;
use std::string;

opaque record List[T] {}

protocol Mappable for C[_] {
    fn map[T, U](c: C[T], f: (T) -> U) -> C[U]
    fn filter[T](c: C[T], keep: (T) -> bool) -> C[T]
    fn fold[T, A](c: C[T], init: A, step: (A, T) -> A) -> A
}

impl Mappable for List {
    fn map[T, U](c: List[T], f: (T) -> U) -> List[U] {
        let out: List[U] = [];
        for x in c {
            out = push(out, f(x));
        };
        out
    }

    fn filter[T](c: List[T], keep: (T) -> bool) -> List[T] {
        let out: List[T] = [];
        for x in c {
            if keep(x) {
                out = push(out, x);
            };
        };
        out
    }

    fn fold[T, A](c: List[T], init: A, step: (A, T) -> A) -> A {
        let acc = init;
        for x in c {
            acc = step(acc, x);
        };
        acc
    }
}

// Immutable lists. Every operation returns a new list; these are values, which is what
// makes their generic argument covariant.
//
// The copy is not always paid for. A uniquely owned list (`rc == 1`) is updated in place,
// so `push` in a loop is amortised O(1) as long as the old binding is not kept. Hold on to
// the input as well and every `push` copies the whole list, which turns that loop
// quadratic -- the one performance cliff in this module worth knowing about.

/// How a list renders. An ordinary library impl rather than a walk baked into the compiler:
/// `Display` is a protocol because formatting genuinely varies (docs/decisions.md), where
/// equality and order do not and stay structural primitives.
///
/// This is the shape `protocols/library_impl_for_a_container.neon` was written to prove the
/// dispatch machinery could express -- a generic head matched against the receiver, the bound
/// discharged against whatever the head bound `T` to, and one lowered body per element type.
/// It lives here now rather than in a test, which is what "the litmus graduates" means.
///
/// Nested lists need no special case: `[[1, 2], [3]]` discharges `T: Display` against
/// `List[i64]`, which this same impl covers.
///
/// Not an orphan: this module declares `List`.
impl[T] Display for List[T] where T: Display {
    fn to_string(v: List[T]) -> str {
        let parts: List[str] = [];
        for x in v {
            parts = push(parts, to_string(x));
        };
        let inner = string::join(parts, ", ");
        "[#{inner}]"
    }
}

@pure @native("neon_list_new") fn new[T]() -> List[T]
/// Preallocate capacity for `n` elements to avoid regrowth while building. The list comes
/// back EMPTY -- this reserves room, it does not produce elements. For `n` copies of a
/// value, which is what a fixed-size buffer wants, use `repeat`.
@pure @native("neon_list_new_with_capacity") fn new_with_capacity[T](n: i64) -> List[T]
@pure @native("neon_list_len") fn len[T](xs: List[T]) -> i64

/// Every element of `xs` replaced by `v`, keeping its length: resetting a buffer between
/// passes without giving up the allocation it already has.
///
/// Takes the list rather than a count, like everything else here: a constructor would be
/// the only function in this module that is not `xs`-first, and "operations take a list and
/// return a new one" is the shape the whole module is in. Building a sized buffer from
/// nothing is `repeat`, which is a different job with a name that says which.
///
/// The empty list fills to the empty list -- there is nothing to replace, which is the
/// answer rather than an edge case.
///
/// Written in Neon rather than as a native. `push` already retains `v` once per copy, so a
/// native would reimplement the element witness handling for no asymptotic gain: the
/// reservation means no regrowth and pushing into a uniquely owned list is in place, so
/// this is one allocation and `len` writes.
fn fill[T](xs: List[T], v: T) -> List[T] {
    repeat(v, len(xs))
}

/// `n` copies of `v`: the fixed-size buffer a tape, a grid row, a histogram or a sieve
/// starts from. `new_with_capacity` does not do this -- it reserves room and hands back an
/// empty list -- so without this the only way to get one is a `push` loop at every call
/// site, which is a lot of ceremony for "ten zeroes".
///
/// Argument order and name both follow `string::repeat(s, n)`: the thing first, the count
/// second. It is the one constructor here that is not `xs`-first, which is why it is named
/// for what it produces rather than for a list it does not have.
///
/// `n <= 0` is the empty list rather than an error, matching `string::repeat` -- the
/// natural reading of "zero copies", and it keeps this out of the `throws` machinery for a
/// case every caller would have to handle and none would want to.
///
/// Written in Neon rather than as a native. `push` already retains `v` once per copy, so a
/// native would reimplement the element witness handling for no asymptotic gain: the
/// reservation means no regrowth and pushing into a uniquely owned list is in place, so
/// this is one allocation and `n` writes.
fn repeat[T](v: T, n: i64) -> List[T] {
    let out: List[T] = new_with_capacity(n);
    let i = 0;
    while i < n {
        out = push(out, v);
        i = i + 1;
    };
    out
}

/// The unchecked primitives. A native cannot build the tagged result a throwing function
/// returns, nor construct an `IndexError` -- both are program-specific layouts codegen owns.
/// So the native does the unchecked operation and the check lives here, in the language,
/// where the error record is declared and its message can name the offending index.
internal mod raw {
    @pure @native("neon_list_set") fn set_unchecked[T](xs: List[T], i: i64, v: T) -> List[T]
}

/// `@inline` on both: each is a bounds check around a primitive, and the call plus the
/// tagged-result return cost more than the body. Measured on the brainfuck benchmark, where
/// `set` is the hot loop's only write: 1.09s -> 0.84s. gcc will not do this on its own --
/// branch hints, outlining the cold error path and `static` linkage each moved it under 4%.
@inline
fn get[T](xs: List[T], i: i64) throws IndexError -> T {
    if i < 0 or i >= len(xs) {
        throw IndexError { message: "index #{i} out of range for length #{len(xs)}" };
    }
    xs[i]
}

@inline
fn set[T](xs: List[T], i: i64, v: T) throws IndexError -> List[T] {
    if i < 0 or i >= len(xs) {
        throw IndexError { message: "index #{i} out of range for length #{len(xs)}" };
    }
    raw::set_unchecked(xs, i, v)
}
@pure @native("neon_list_push") fn push[T](xs: List[T], v: T) -> List[T]
@pure @native("neon_list_concat") fn concat[T](a: List[T], b: List[T]) -> List[T]

// ---- sorting ----
//
// Merge sort, and deliberately so. A comparator can lie -- `sort` on a list holding
// NaN is the documented case, since NaN compares false against everything -- and an
// introsort-style algorithm can read past its bounds when that happens. Merging only
// ever advances an index it has already bounds-checked, so a lying comparator costs
// you a wrong order and nothing else.
//
// Stable: `merge` takes from the left whenever the two are equal, which is why the
// test is `cmp(b, a) is :lt` rather than `cmp(a, b) is :gt`.

fn sort[T](xs: List[T]) -> List[T] where T: Ord {
    sort_by(xs, (a: T, b: T) => if a < b { :lt } else if b < a { :gt } else { :eq })
}

fn sort_by[T](xs: List[T], cmp: (T, T) -> Ordering) -> List[T] {
    let n = len(xs);
    if n <= 1 {
        xs
    } else {
        let mid = n / 2;
        let left: List[T] = [];
        let right: List[T] = [];
        let i = 0;
        while i < mid {
            left = push(left, xs[i]);
            i = i + 1;
        };
        while i < n {
            right = push(right, xs[i]);
            i = i + 1;
        };
        merge(sort_by(left, cmp), sort_by(right, cmp), cmp)
    }
}

/// Merge two lists that are each already sorted by `cmp`. `sort_by`'s combining step,
/// exposed because it is useful on its own. Passing unsorted input is not an error and not
/// checked; it just gives you an unsorted result.
fn merge[T](a: List[T], b: List[T], cmp: (T, T) -> Ordering) -> List[T] {
    let out: List[T] = [];
    let i = 0;
    let j = 0;
    while i < len(a) and j < len(b) {
        if cmp(b[j], a[i]) is :lt {
            out = push(out, b[j]);
            j = j + 1;
        } else {
            out = push(out, a[i]);
            i = i + 1;
        };
    };
    while i < len(a) {
        out = push(out, a[i]);
        i = i + 1;
    };
    while j < len(b) {
        out = push(out, b[j]);
        j = j + 1;
    };
    out
}

// ---- queries ----
//
// `contains` and `find` compare with `==`, which is structural on every type but a
// closure and needs no bound (equality is total by design -- see docs/decisions.md), so
// neither takes a `where`. Both walk the whole list even once the answer is settled: they
// are O(n) on a hit as well as a miss.

fn is_empty[T](xs: List[T]) -> bool {
    len(xs) == 0
}

/// `null` rather than a throw: asking for the first element of a possibly-empty list is
/// ordinary, and the caller usually has something to do in the empty case. `get` throws
/// because an out-of-range *index* is a mistake; an empty list is not.
fn first[T](xs: List[T]) -> T | null {
    if is_empty(xs) { null } else { xs[0] }
}

fn last[T](xs: List[T]) -> T | null {
    if is_empty(xs) { null } else { xs[len(xs) - 1] }
}

fn contains[T](xs: List[T], v: T) -> bool {
    let found = false;
    for x in xs {
        if x == v {
            found = true;
        };
    };
    found
}

/// The first index holding `v`, or `null`. Mirrors `string::find`, which answers the same
/// question about bytes and returns the same shape.
fn find[T](xs: List[T], v: T) -> i64 | null {
    let at: i64 | null = null;
    let i = 0;
    for x in xs {
        if x == v and at is null {
            at = i;
        };
        i = i + 1;
    };
    at
}

// ---- transformations ----

fn reverse[T](xs: List[T]) -> List[T] {
    let out: List[T] = [];
    let i = len(xs);
    while i > 0 {
        i = i - 1;
        out = push(out, xs[i]);
    };
    out
}

/// Half-open `[from, to)`, matching `string::slice` and `range`.
fn slice[T](xs: List[T], from: i64, to: i64) throws IndexError -> List[T] {
    if from < 0 or from > to or to > len(xs) {
        throw IndexError { message: "slice #{from}..#{to} out of range for length #{len(xs)}" };
    };
    let out: List[T] = [];
    let i = from;
    while i < to {
        out = push(out, xs[i]);
        i = i + 1;
    };
    out
}

/// Monomorphic because there is no numeric bound to write and no overloading: `sum` over
/// `i64` is the case that comes up.
fn sum(xs: List[i64]) -> i64 {
    let total = 0;
    for x in xs {
        total = total + x;
    };
    total
}

/// Whether `pred` holds for at least one element. Stops at the first hit, so a predicate
/// with effects runs only up to there -- the same interleaving pipelines already promise.
/// Empty list: `false`, the identity of `or`.
fn any[T](xs: List[T], pred: (T) -> bool) -> bool {
    let found = false;
    for x in xs {
        if pred(x) {
            found = true;
            break;
        };
    };
    found
}

/// Whether `pred` holds for every element. Stops at the first miss. Empty list: `true`,
/// the identity of `and` -- "all zero of them" is vacuously so, as everywhere else.
fn all[T](xs: List[T], pred: (T) -> bool) -> bool {
    let ok = true;
    for x in xs {
        if !pred(x) {
            ok = false;
            break;
        };
    };
    ok
}

/// Pairs, element by element, as long as the SHORTER list: the tail of the longer one has
/// no partner, and inventing a filler would need a `T` from nowhere. Callers who care that
/// the lengths matched can compare `len` first.
fn zip[A, B](a: List[A], b: List[B]) -> List[(A, B)] {
    let n = if len(a) < len(b) { len(a) } else { len(b) };
    let out: List[(A, B)] = new_with_capacity(n);
    let i = 0;
    while i < n {
        out = push(out, (a[i], b[i]));
        i = i + 1;
    };
    out
}

/// The first `n` elements -- or all of them when `n` exceeds the length, or none when
/// `n <= 0`. Clamping rather than throwing is the point of `take`: "the first up-to-ten"
/// is the question being asked, and `slice`, which throws, already serves exact bounds.
fn take[T](xs: List[T], n: i64) -> List[T] {
    let stop = if n < len(xs) { n } else { len(xs) };
    let out: List[T] = [];
    let i = 0;
    while i < stop {
        out = push(out, xs[i]);
        i = i + 1;
    };
    out
}

/// Everything after the first `n` -- the whole list when `n <= 0`, empty when `n` exceeds
/// the length. Clamps, like `take`, and for the same reason.
fn drop[T](xs: List[T], n: i64) -> List[T] {
    let out: List[T] = [];
    let start = if n < 0 { 0 } else { n };
    let i = if start < len(xs) { start } else { len(xs) };
    while i < len(xs) {
        out = push(out, xs[i]);
        i = i + 1;
    };
    out
}

/// One level, not recursive: `List[List[T]]` to `List[T]`. A recursive flatten has no
/// type -- each level changes the element type -- which is the usual sign the recursive
/// version was the wrong ask.
fn flatten[T](xss: List[List[T]]) -> List[T] {
    let out: List[T] = [];
    for xs in xss {
        out = concat(out, xs);
    };
    out
}

/// The smallest element, or `null` for the empty list -- the caller usually has an answer
/// for "nothing there", and `first`/`last` already answer the same way. Ties keep the
/// earliest, matching `sort`'s stability and `cmp::min`.
fn min[T](xs: List[T]) -> T | null where T: Ord {
    let best: T | null = null;
    for x in xs {
        let b = best;
        if b is null {
            best = x;
        } else {
            if x < b {
                best = x;
            };
        };
    };
    best
}

/// The largest element, or `null` for the empty list. Ties keep the earliest.
fn max[T](xs: List[T]) -> T | null where T: Ord {
    let best: T | null = null;
    for x in xs {
        let b = best;
        if b is null {
            best = x;
        } else {
            if b < x {
                best = x;
            };
        };
    };
    best
}

/// Each element with its index: `[(0, xs[0]), (1, xs[1]), ..]`. The named form of
/// `zip(range(0, len(xs)), xs)`, minus the list of indices that zip would build.
fn enumerate[T](xs: List[T]) -> List[(i64, T)] {
    let out: List[(i64, T)] = new_with_capacity(len(xs));
    let i = 0;
    for x in xs {
        out = push(out, (i, x));
        i = i + 1;
    };
    out
}

/// Runs of `n` consecutive elements: `chunks([1,2,3,4,5], 2)` is `[[1,2],[3,4],[5]]`.
/// The last chunk is short when the length does not divide; `n <= 0` is the empty list,
/// matching `repeat` — the natural reading of "chunks of nothing", and not a trap for a
/// computed size that came out zero.
fn chunks[T](xs: List[T], n: i64) -> List[List[T]] {
    if n <= 0 {
        []
    } else {
        let out: List[List[T]] = [];
        let cur: List[T] = [];
        for x in xs {
            cur = push(cur, x);
            if len(cur) == n {
                out = push(out, cur);
                cur = [];
            };
        };
        if !is_empty(cur) {
            out = push(out, cur);
        };
        out
    }
}

/// Every window of `n` consecutive elements: `windows([1,2,3,4], 2)` is
/// `[[1,2],[2,3],[3,4]]`. All windows are full — a list shorter than `n` has none —
/// and `n <= 0` is the empty list, as for `chunks`.
fn windows[T](xs: List[T], n: i64) -> List[List[T]] {
    if n <= 0 {
        []
    } else {
        let out: List[List[T]] = [];
        let i = 0;
        while i + n <= len(xs) {
            let w: List[T] = new_with_capacity(n);
            for j in i..i + n {
                w = push(w, xs[j]);
            };
            out = push(out, w);
            i = i + 1;
        };
        out
    }
}

/// The elements bucketed by what `key` says about each, keeping their order within a
/// bucket: `group_by(["ant", "bee", "ape"], first_letter)` is `{"a": ["ant", "ape"],
/// "b": ["bee"]}`. The buckets come back as a `Map`, so anything a map key can be — any
/// structural value — can classify.
fn group_by[T, K](xs: List[T], key: (T) -> K) -> Map[K, List[T]] {
    let out: Map[K, List[T]] = map::new();
    for x in xs {
        let k = key(x);
        let bucket = map::get_or(out, k, []);
        out = map::set(out, k, push(bucket, x));
    };
    out
}

/// The index of the first element `pred` accepts, or `null`. `find`'s by-predicate
/// sibling: `find` matches by value (`==`), this by an arbitrary test.
fn position[T](xs: List[T], pred: (T) -> bool) -> i64 | null {
    let at: i64 | null = null;
    let i = 0;
    for x in xs {
        if pred(x) and at is null {
            at = i;
        };
        i = i + 1;
    };
    at
}

/// How many elements `pred` accepts.
fn count[T](xs: List[T], pred: (T) -> bool) -> i64 {
    let n = 0;
    for x in xs {
        if pred(x) {
            n = n + 1;
        };
    };
    n
}

/// The accepted elements and the rejected ones, each keeping their order: `(kept,
/// dropped)`. One pass, where `filter` twice is two — and it says at the call site that
/// the two halves partition the whole.
fn partition[T](xs: List[T], pred: (T) -> bool) -> (List[T], List[T]) {
    let yes: List[T] = [];
    let no: List[T] = [];
    for x in xs {
        if pred(x) {
            yes = push(yes, x);
        } else {
            no = push(no, x);
        };
    };
    (yes, no)
}

/// The distinct elements, in first-seen order. O(n) through a `Map` seen-set rather than
/// the O(n^2) of `contains` per element; any structural value works, since map keys do.
fn unique[T](xs: List[T]) -> List[T] {
    let seen: Map[T, null] = map::new();
    let out: List[T] = [];
    for x in xs {
        if !map::contains(seen, x) {
            seen = map::set(seen, x, null);
            out = push(out, x);
        };
    };
    out
}

/// The index of `target` in a list that MUST be sorted ascending, or `null`. Undefined —
/// not wrong, just unspecified — on an unsorted list, exactly as C's `bsearch` is: the
/// precondition is the caller's to keep, and `sort` is how. O(log n), which is the whole
/// reason to reach for it over `find`.
fn binary_search[T](xs: List[T], target: T) -> i64 | null where T: Ord {
    let lo = 0;
    let hi = len(xs);
    let found: i64 | null = null;
    while lo < hi and found is null {
        let mid = lo + (hi - lo) / 2;
        let v = xs[mid];
        if v == target {
            found = mid;
        } else if v < target {
            lo = mid + 1;
        } else {
            hi = mid;
        };
    };
    found
}
