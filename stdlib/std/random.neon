// Randomness as a value. An `Rng` is the generator's state — xoshiro256++, four words —
// and every function takes one on the LEFT and hands the successor back on the left too,
// its answer beside it:
//
//     let rng = random::new(42);
//     let (rng, roll) = random::int(rng, 1, 7);
//     let (rng, side) = random::flip(rng);
//
// State on the left in both directions is what makes the threading COMPOSE: the generator
// sits in the same position at every call, so a run of draws is a column of
// `let (rng, x) = ...(rng, ...)` lines that reads straight down, and nothing has to hunt
// for which end of the tuple the successor came out of.
//
// The rebind is the language's ordinary gait (`out = push(out, x)` is the same shape),
// and a linearly-threaded Rng is uniquely owned, so the "new" state is an in-place
// update. What the threading buys is that randomness is REPRODUCIBLE BY CONSTRUCTION:
// the sequence is a function of the seed and the calls, not of whatever else the program
// did between them — no library can perturb your rolls, and a test can hold the exact
// generator its subject saw. A seeded generator is a pure computation; the only effect
// in the whole domain is asking the OS for entropy, and that is the one impure function
// here.
//
// `opaque` so the words stay this module's business: reachable state would make "the
// sequence the algorithm defines" a promise anyone could quietly break.
//
// The threading is the cost of that guarantee, and for a handful of draws it is a lot of
// rebinding. There is no hidden default generator on purpose: a global one would be the
// single impure, unreproducible thing in the module, and this language has no mutable
// global to put it in anyway. The answer to "I just want ten numbers" is to ask for ten:
// `ints`, `floats`, `sample` and `choices` thread the generator ONCE and hand back the
// batch, so the rebind happens per call to them, not per number.

use std::list;

/// A generator's state -- xoshiro256++'s four words. Threaded on the left through every draw
/// and handed back as its successor; `opaque` so the sequence stays this module's to define.
opaque record Rng { s0: i64, s1: i64, s2: i64, s3: i64 }

internal mod raw {
    /// splitmix64 over the seed, per xoshiro's authors: it cannot yield the all-zero
    /// state the generator must never sit in.
    @pure @native("neon_rng_seed") fn seed(n: i64) -> (i64, i64, i64, i64)
    @pure @native("neon_rng_next") fn next(s0: i64, s1: i64, s2: i64, s3: i64) -> (i64, i64, i64, i64, i64)
    /// Lemire rejection, so no modulo bias; traps when `n <= 0`.
    @pure @native("neon_rng_bounded") fn bounded(s0: i64, s1: i64, s2: i64, s3: i64, n: i64) -> (i64, i64, i64, i64, i64)
    @pure @native("neon_rng_float") fn float_bits(s0: i64, s1: i64, s2: i64, s3: i64) -> (f64, i64, i64, i64, i64)
    @native("neon_os_entropy") fn entropy() -> i64
}

/// The generator `seed` names. Same seed, same sequence, forever — that is the contract,
/// and benchmarks and tests are built on it.
fn new(seed: i64) -> Rng {
    let (s0, s1, s2, s3) = raw::seed(seed);
    Rng { s0: s0, s1: s1, s2: s2, s3: s3 }
}

/// A generator seeded from the OS. The module's ONE effectful function: everything
/// downstream of the `Rng` it returns is pure.
fn from_entropy() -> Rng {
    new(raw::entropy())
}

/// The raw 64 bits, any value an `i64` can hold.
fn next(r: Rng) -> (Rng, i64) {
    let (v, s0, s1, s2, s3) = raw::next(r.s0, r.s1, r.s2, r.s3);
    (Rng { s0: s0, s1: s1, s2: s2, s3: s3 }, v)
}

/// Uniform in the half-open `[lo, hi)`, like `range` and `slice` and everything else.
/// An empty range traps — an element of nothing is a mistake, as dividing by zero is.
fn int(r: Rng, lo: i64, hi: i64) -> (Rng, i64) {
    let (v, s0, s1, s2, s3) = raw::bounded(r.s0, r.s1, r.s2, r.s3, hi - lo);
    (Rng { s0: s0, s1: s1, s2: s2, s3: s3 }, lo + v)
}

/// Uniform in `[0, 1)`: the top 53 bits over 2^53, so every representable step is
/// equally likely.
fn float(r: Rng) -> (Rng, f64) {
    let (v, s0, s1, s2, s3) = raw::float_bits(r.s0, r.s1, r.s2, r.s3);
    (Rng { s0: s0, s1: s1, s2: s2, s3: s3 }, v)
}

/// A fair coin. `[0, 2)` rather than the low bit of `next`, so it rides the same unbiased
/// path `int` does and needs no claim about which of xoshiro's bits are the good ones.
fn flip(r: Rng) -> (Rng, bool) {
    let (r2, v) = int(r, 0, 2);
    (r2, v == 1)
}

/// One element, uniformly. Throws on the empty list rather than trapping: a list is
/// data, and data being empty is the caller's ordinary world, not a broken program.
fn pick[T](r: Rng, xs: List[T]) throws IndexError -> (Rng, T) {
    if list::is_empty(xs) {
        throw IndexError { message: "pick from an empty list" };
    }
    let (r2, i) = int(r, 0, list::len(xs));
    (r2, xs[i])
}

/// A uniform permutation — Fisher–Yates, walking from the end. `try!` on the swaps is
/// exact, not optimistic: both indices are bounded by the loop, so a throw is
/// unreachable and deserves the panic it would get.
fn shuffle[T](r: Rng, xs: List[T]) -> (Rng, List[T]) {
    let out = xs;
    let rng = r;
    let i = list::len(out) - 1;
    while i > 0 {
        let (r2, j) = int(rng, 0, i + 1);
        rng = r2;
        let a = out[i];
        out = try! list::set(out, i, out[j]);
        out = try! list::set(out, j, a);
        i = i - 1;
    };
    (rng, out)
}

// ---- batches ----
//
// Thread the generator once, draw many. Reach for these wherever a loop would otherwise
// rebind an `Rng` a number at a time; the sequence is identical to calling the single-draw
// form in a loop, so reproducibility is unchanged.

/// `n` draws from the half-open `[lo, hi)`.
fn ints(r: Rng, n: i64, lo: i64, hi: i64) -> (Rng, List[i64]) {
    let out: List[i64] = [];
    let rng = r;
    let i = 0;
    while i < n {
        let (r2, v) = int(rng, lo, hi);
        rng = r2;
        out = list::push(out, v);
        i = i + 1;
    };
    (rng, out)
}

/// `n` draws from `[0, 1)`.
fn floats(r: Rng, n: i64) -> (Rng, List[f64]) {
    let out: List[f64] = [];
    let rng = r;
    let i = 0;
    while i < n {
        let (r2, v) = float(rng);
        rng = r2;
        out = list::push(out, v);
        i = i + 1;
    };
    (rng, out)
}

/// `k` distinct elements, in uniformly random order: a partial Fisher–Yates that stops
/// after `k` swaps rather than shuffling the whole list. Throws when `k` exceeds the list,
/// because you cannot draw more distinct things than there are -- for draws WITH
/// replacement, where that ceiling does not apply, see `choices`.
fn sample[T](r: Rng, xs: List[T], k: i64) throws IndexError -> (Rng, List[T]) {
    if k > list::len(xs) {
        throw IndexError { message: "sample of #{k} from #{list::len(xs)} elements" };
    }
    let pool = xs;
    let rng = r;
    let out: List[T] = [];
    // `m` is the length of the still-active prefix `[0, m)`; a drawn slot is filled from the
    // shrinking tail and dropped out of range, so no element is ever picked twice.
    let m = list::len(pool);
    let i = 0;
    while i < k {
        let (r2, j) = int(rng, 0, m);
        rng = r2;
        out = list::push(out, pool[j]);
        pool = try! list::set(pool, j, pool[m - 1]);
        m = m - 1;
        i = i + 1;
    };
    (rng, out)
}

/// `k` elements drawn independently WITH replacement, so `k` may exceed the list and
/// repeats are expected. Throws only on the empty list, where there is nothing to draw.
fn choices[T](r: Rng, xs: List[T], k: i64) throws IndexError -> (Rng, List[T]) {
    if list::is_empty(xs) {
        throw IndexError { message: "choices from an empty list" };
    }
    let out: List[T] = [];
    let rng = r;
    let i = 0;
    while i < k {
        let (r2, idx) = int(rng, 0, list::len(xs));
        rng = r2;
        out = list::push(out, xs[idx]);
        i = i + 1;
    };
    (rng, out)
}
