// Files.
//
// A `File` is a handle: open once, read or write many times, close when done. `opaque`
// means its field is visible only inside this module, so nothing outside can read a
// descriptor out of it or forge one from an integer.
//
// Failure is a value at the boundary and a throw above it. Every native returns `-errno`,
// and `read_all` -- which returns data *and* can fail -- uses a native out-parameter,
// which codegen hands back as a tuple. Nothing is stashed in a global for the caller to
// read afterwards.
//
// Text only for now: there is no buffer type, so `read` hands back a `str` and
// `read_bytes` the same bytes typed as `Bytes`. Both are the same representation --
// `str` in this language is already unvalidated bytes.
//
// A path is a `std::path::Path`, not a `str`. That type owns separator handling and the
// platform rules, so this module never parses one: it converts at the syscall boundary with
// `path::to_str` and does nothing else with the text. The two modules changed together,
// which is what made it worth doing -- a `Path` that `fs` did not accept would have meant a
// conversion at every call site, which is the objection `std::path`'s header used to raise
// against having the type at all.

use std::string;
use std::resource;
use std::path;

/// Thrown by everything here that can fail. Its `message` names the operation, the path and
/// the `strerror` text, so a caller has nothing to reassemble. A `File` does not remember
/// the path it was opened with, so failures on a handle say `<file>` instead; keep the path
/// yourself if the message has to identify it.
record IoError { message: str }
impl Display for IoError { fn to_string(v: IoError) -> str { v.message } }
impl Error for IoError { fn message(v: IoError) -> str { v.message } }

/// Bytes that are not text. `str` already holds arbitrary bytes -- slicing it may split a
/// UTF-8 sequence and nothing validates -- so this is a *nominal* distinction rather than a
/// new representation: it costs nothing at run time, and it stops a PNG being typed as
/// something you would call `to_upper` on. Cross over with `as` in either direction, and
/// reach the whole `std::string` API by casting.
newtype Bytes = str

/// What can be written in one go. A tree rather than a buffer: building it costs no copying
/// and no concatenation -- nesting a list inside a list is a pointer, not a concatenation --
/// and `write_all` turns the leaves into an `iovec` array for `writev`. This is Erlang's
/// iodata, and the reason immutable strings do not make output quadratic. Build the tree,
/// write once.
mu type IoList = str | Bytes | List[IoList]

/// A handle is a descriptor guarded by a `Resource`, so all of it comes from one place:
/// cleanup when the last reference dies, an armed flag so an explicit `close` and the drop
/// cannot both fire, and a released flag that turns use-after-close into an error rather
/// than a read of a descriptor number that has since been reused.
///
/// `opaque` is what keeps the guard private -- without it a caller could reach `f.r` and
/// release the descriptor behind this module's back, which is the whole reason the guard
/// is not just a plain field holding an `i64`.
sealed record File { r: resource::Resource[i64, IoError] }

internal mod raw {
    @native("neon_io_open") fn open(path: str, mode: i64) -> i64
    @native("neon_io_close") fn close(fd: i64) -> i64
    /// Returns the contents and the status together: the tuple's tail is a C out-parameter.
    @native("neon_io_read_all") fn read_all(fd: i64) -> (str, i64)
    @native("neon_io_writev") fn writev(fd: i64, parts: List[str]) -> i64
    @native("neon_io_remove") fn remove(path: str) -> i64
    @native("neon_io_strerror") fn strerror(code: i64) -> str
    @native("neon_io_mkdir") fn mkdir(path: str) -> i64
    @native("neon_io_rename") fn rename(from: str, to: str) -> i64
    @native("neon_io_is_dir") fn is_dir(path: str) -> i64
    @native("neon_io_size") fn size(path: str) -> i64
    /// The names, NUL-separated, and the status: the tuple's tail is a C out-parameter.
    @native("neon_io_read_dir") fn read_dir(path: str) -> (str, i64)

    /// The cleanup a handle carries: closing is the resource's job, so a forgotten close
    /// -- or one skipped by a `throw` -- still happens, and its error is available to
    /// whoever closes explicitly.
    fn guard(fd: i64) -> File {
        File { r: resource::new(fd, (d: i64) => {
            let code = raw::close(d);
            if code < 0 {
                try fail(code, "cannot close", "<file>");
            }
            null
        }) }
    }
}

internal mod probe {
    @native("neon_io_exists") fn exists(path: str) -> bool
}

/// Whether anything is there. Not a permission or a type check, and racy by nature: the
/// answer describes the moment it was asked, so code that acts on it should open and handle
/// the failure instead.
fn exists(p: path::Path) -> bool {
    probe::exists(path::to_str(p))
}

fn fail(code: i64, what: str, path: str) throws IoError -> null {
    throw IoError { message: "#{what} `#{path}`: #{raw::strerror(code)}" };
}

// ---- handles ----

fn open(p: path::Path) throws IoError -> File {
    let fd = raw::open(path::to_str(p), 0);
    if fd < 0 {
        try fail(fd, "cannot open", path::to_str(p));
    };
    raw::guard(fd)
}

fn create(p: path::Path) throws IoError -> File {
    let fd = raw::open(path::to_str(p), 1);
    if fd < 0 {
        try fail(fd, "cannot create", path::to_str(p));
    };
    raw::guard(fd)
}

fn open_append(p: path::Path) throws IoError -> File {
    let fd = raw::open(path::to_str(p), 2);
    if fd < 0 {
        try fail(fd, "cannot open", path::to_str(p));
    };
    raw::guard(fd)
}

/// Release the descriptor now rather than whenever the handle dies. Optional -- ARC closes
/// it either way -- and closing twice is a no-op, because a closed handle has nothing left
/// to fail at and an fd number gets reused.
fn close(f: File) throws IoError -> null {
    try resource::release(f.r);
    null
}

/// The descriptor, or an `IoError` if this handle was already closed. The check never
/// leaves the process, so a closed handle cannot reach a descriptor number that was
/// reused in between -- which an `EBADF` from the kernel would not have ruled out.
fn fd_of(f: File) throws IoError -> i64 {
    try resource::get(f.r) catch (e) {
        throw IoError { message: "this file is already closed" }
    }
}

// ---- reading and writing through a handle ----

fn read_all(f: File) throws IoError -> str {
    let fd = try fd_of(f);
    let (data, code) = raw::read_all(fd);
    if code < 0 {
        try fail(code, "cannot read", "<file>");
    };
    data
}

/// Write every piece of `data`, in order. The payload bytes are never copied: the tree's
/// leaves become an `iovec` array of pointer/length pairs. One `writev` covers up to
/// `IOV_MAX` pieces, so a larger tree takes one syscall per batch, and a partial write is
/// resumed rather than reported.
fn write_all(f: File, data: IoList) throws IoError -> null {
    let fd = try fd_of(f);
    let code = raw::writev(fd, flatten(data));
    if code < 0 {
        try fail(code, "cannot write to", "<file>");
    };
    null
}

// ---- iolists ----

/// The leaves, left to right. `Bytes` and `str` share a representation, so a leaf of either
/// kind becomes the same view; only the type told them apart.
fn flatten(data: IoList) -> List[str] {
    let out: List[str] = [];
    collect(data, out)
}

/// Accumulator-passing, because there is nothing to mutate: each call returns the list it
/// was given plus whatever its subtree contributed.
fn collect(data: IoList, acc: List[str]) -> List[str] {
    if data is Bytes {
        std::list::push(acc, data as Bytes as str)
    } else if data is str {
        std::list::push(acc, data as str)
    } else {
        let out = acc;
        for part in data as List[IoList] {
            out = collect(part, out);
        };
        out
    }
}

// ---- one-shot helpers ----
//
// Built on the handle API rather than beside it, so there is one implementation of each
// operation. They open and close per call by definition; reach for a `File` when that
// matters.

/// No explicit close, and no wrapping to close on the error path: the handle is refcounted,
/// so the descriptor closes when `f` dies -- including when `read_all` throws straight past
/// the end of this function. Catching, closing and rethrowing here would be dead weight;
/// ARC already does it. The same holds for every helper below that opens a handle.
fn read(p: path::Path) throws IoError -> str {
    let f = try open(p);
    try read_all(f)
}

fn read_bytes(p: path::Path) throws IoError -> Bytes {
    (try read(p)) as Bytes
}

fn read_lines(p: path::Path) throws IoError -> List[str] {
    string::lines(try read(p))
}

fn write(p: path::Path, data: IoList) throws IoError -> null {
    let f = try create(p);
    try write_all(f, data);
    null
}

fn append(p: path::Path, data: IoList) throws IoError -> null {
    let f = try open_append(p);
    try write_all(f, data);
    null
}

fn remove(p: path::Path) throws IoError -> null {
    let code = raw::remove(path::to_str(p));
    if code < 0 {
        try fail(code, "cannot remove", path::to_str(p));
    };
    null
}

// ---- directories and metadata ----
//
// No `@cfg` here at all. The platform difference is real -- `mkdir` against
// `CreateDirectoryW`, `readdir` against `FindFirstFileW` -- and it lives in the runtime's
// `platform.h`, which is where a difference between two syscalls belongs. What Neon sees is
// one operation with one meaning, so there is one body.
//
// These were `TODO(..)` on the Windows side until the loop closed: `neon compile --cfg
// windows --cc x86_64-w64-mingw32-gcc --runtime <mingw archive>` produces a PE that Wine
// runs, so the Windows half could be written against something that executes rather than
// something that only type-checks. `verify/windows.sh` is that path.

fn mkdir(p: path::Path) throws IoError -> null {
    let code = raw::mkdir(path::to_str(p));
    if code < 0 {
        try fail(code, "cannot create directory", path::to_str(p));
    };
    null
}

/// Replaces an existing destination, which is POSIX `rename`'s behaviour and what Windows is
/// asked for explicitly (`MOVEFILE_REPLACE_EXISTING`) so the two agree. A cross-volume move
/// is permitted on Windows and is NOT atomic there; POSIX refuses it outright. Do not rely on
/// atomicity across volumes on either.
fn rename(from: path::Path, to: path::Path) throws IoError -> null {
    let code = raw::rename(path::to_str(from), path::to_str(to));
    if code < 0 {
        try fail(code, "cannot rename", path::to_str(from));
    };
    null
}

/// Whether the path names a directory. `false` for a file AND for something that is not
/// there: this answers a question about a kind, and "no such path" is not a failure to report
/// differently from "not a directory".
fn is_dir(p: path::Path) -> bool {
    raw::is_dir(path::to_str(p)) == 1
}

/// The size in bytes.
fn size(p: path::Path) throws IoError -> i64 {
    let n = raw::size(path::to_str(p));
    if n < 0 {
        try fail(n, "cannot stat", path::to_str(p));
    };
    n
}

/// The entries of a directory, as NAMES rather than paths. Joining them onto the directory is
/// the caller's choice and `std::path::join`'s job.
///
/// Order is whatever the filesystem gives back, which is not sorted and not stable across
/// runs or platforms. Sort if you need determinism.
fn read_dir(p: path::Path) throws IoError -> List[str] {
    let (names, code) = raw::read_dir(path::to_str(p));
    if code < 0 {
        try fail(code, "cannot read directory", path::to_str(p));
    };
    if string::is_empty(names) { [] } else { string::split(names, "\0") }
}

/// Copy by reading and writing, so it needs no syscall of its own and works wherever `read`
/// and `write` do. It is NOT atomic and does not preserve permissions or timestamps -- a copy
/// that did would be a different function with a different name.
fn copy(from: path::Path, to: path::Path) throws IoError -> null {
    let data = try read_bytes(from);
    try write(to, data as str);
    null
}
