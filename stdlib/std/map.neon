// Immutable maps. Like lists, every operation returns a new map, and a uniquely owned one
// is updated in place, so the copy is only paid for when the input is actually shared.
//
// Unordered. `keys` and `values` walk the table's slots, so their order is a function of
// the hash, not of insertion, and it can change when a `set` grows the table. What does
// hold is that the two agree: `keys(m)[i]` and `values(m)[i]` are the same entry. Sort the
// keys if you need a stable order.

// The map itself: nominal, covariant in its arguments, and opaque -- the storage is
// native. Declared here rather than in the prelude for the same reason `List` is: the
// declaring module owns it, and the prelude's path is the root every program shares.
use std::list;
use std::string;

opaque record Map[K, V] {}

/// How a map renders, an ordinary library impl for the reason `List`'s is one.
///
/// Keys are SORTED, and that is not a formatting preference. A map is unordered -- `keys`
/// walks the table, so the same map built two ways can walk differently -- and a rendering
/// that varied run to run would not be a function of the value. Sorting needs `K: Ord` on top
/// of `K: Display`, which is a real restriction rather than a formality: a map keyed by
/// something with no order has no impl here, and rendering one has to be spelled at the call
/// site where a comparator can be supplied.
impl[K, V] Display for Map[K, V] where K: Display, V: Display, K: Ord {
    fn to_string(m: Map[K, V]) -> str {
        let parts: List[str] = [];
        for k in list::sort(keys(m)) {
            let key = to_string(k);
            let val = to_string(m[k]);
            parts = list::push(parts, "#{key}: #{val}");
        };
        let inner = string::join(parts, ", ");
        "{#{inner}}"
    }
}

@pure @native("neon_map_new") fn new[K, V]() -> Map[K, V]
@pure @native("neon_map_len") fn len[K, V](m: Map[K, V]) -> i64
/// Thrown by `get`. A native can build neither the tagged result a throwing function
/// returns nor the error record itself -- both are layouts codegen generates per program --
/// so the record and the check both live here.
record KeyError { message: str }
impl Display for KeyError { fn to_string(v: KeyError) -> str { v.message } }
impl Error for KeyError { fn message(v: KeyError) -> str { v.message } }

/// The checked form of `m[k]`, which traps on a missing key rather than throwing. Two
/// lookups: the `contains` probe and then the index. `get_or` costs the same and needs no
/// `try` -- reach for it when absence is expected.
fn get[K, V](m: Map[K, V], k: K) throws KeyError -> V {
    if !contains(m, k) {
        throw KeyError { message: "key not present" };
    }
    m[k]
}
@pure @native("neon_map_set") fn set[K, V](m: Map[K, V], k: K, v: V) -> Map[K, V]
@pure @native("neon_map_contains") fn contains[K, V](m: Map[K, V], k: K) -> bool
@pure @native("neon_map_keys") fn keys[K, V](m: Map[K, V]) -> List[K]
@pure @native("neon_map_values") fn values[K, V](m: Map[K, V]) -> List[V]

fn is_empty[K, V](m: Map[K, V]) -> bool {
    len(m) == 0
}

/// `remove` on an absent key is not an error: it says "this key is not in the result",
/// which is already true. Returning the map unchanged keeps it usable in a chain.
@pure @native("neon_map_remove") fn remove[K, V](m: Map[K, V], k: K) -> Map[K, V]

/// The value for `k`, or `fallback`. `get` throws because a missing key is often a
/// mistake; when it is not, this is the shape that says so at the call site rather than
/// through a `try`.
fn get_or[K, V](m: Map[K, V], k: K, fallback: V) -> V {
    if contains(m, k) { m[k] } else { fallback }
}

/// `k` set to `f` of its current value, or of `fallback` when `k` is absent.
///
/// This is the counting idiom, and the reason it is a primitive rather than something to
/// spell out at the call site. Written by hand it is
///
///     counts = map::set(counts, w, map::get_or(counts, w, 0) + 1)
///
/// which walks the table three times for one increment -- `get_or` is `contains` and then
/// an index, and `set` probes again -- re-hashing `w` each time. `update` probes once:
///
///     counts = map::update(counts, w, 0, (v: i64) => v + 1)
///
/// Nothing recovers the three-pass version automatically. Fusing it would mean proving the
/// two maps are the same value and that nothing observes it in between, and getting that
/// wrong is a miscompile; getting it *silently un-applied* is a 2x cliff with no diagnostic.
/// So the fast shape is one you ask for.
@pure @native("neon_map_update") fn update[K, V](m: Map[K, V], k: K, fallback: V, f: (V) -> V) -> Map[K, V]

/// The entries as `(key, value)` pairs, in table order — the shape `for` destructures.
/// `keys(m)[i]` and `values(m)[i]` already agree on which entry is which; this is that
/// agreement made into one list.
fn entries[K, V](m: Map[K, V]) -> List[(K, V)] {
    let out: List[(K, V)] = std::list::new_with_capacity(len(m));
    let ks = keys(m);
    let vs = values(m);
    let i = 0;
    while i < std::list::len(ks) {
        out = std::list::push(out, (ks[i], vs[i]));
        i = i + 1;
    };
    out
}

/// The two maps combined; on a key in both, `b`'s value wins. Right-biased because
/// `merge(defaults, overrides)` is the case that occurs — the second argument is the one
/// with the last word.
fn merge[K, V](a: Map[K, V], b: Map[K, V]) -> Map[K, V] {
    let out = a;
    for e in entries(b) {
        let (k, v) = e;
        out = set(out, k, v);
    };
    out
}

/// A map from `(key, value)` pairs: `entries`' inverse. A key appearing twice keeps the
/// last pair, matching `set`.
fn from_entries[K, V](pairs: List[(K, V)]) -> Map[K, V] {
    let out: Map[K, V] = new();
    for p in pairs {
        let (k, v) = p;
        out = set(out, k, v);
    };
    out
}

/// Every value replaced by `f` of it, the keys untouched. `list::map` for the value side
/// of a map -- the keys are not a functor argument (see the Mappable note in
/// docs/design/stdlib.md), so this is the only shape that fits.
fn map_values[K, V, W](m: Map[K, V], f: (V) -> W) -> Map[K, W] {
    let out: Map[K, W] = new();
    for e in entries(m) {
        let (k, v) = e;
        out = set(out, k, f(v));
    };
    out
}
