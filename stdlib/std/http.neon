// HTTP/1.1, client and server, over `std::net`'s fiber-aware sockets and llhttp's parser
// (`runtime/src/http.c` wraps it; docs/design/fibers.md for how connections cross fibers).
//
//     // server: one fiber per connection, keep-alive handled, handler per request
//     try http::server::serve(l, (req: http::Request) => {
//         http::server::ok("hello, #{req.target}")
//     });
//
//     // client
//     let resp = try http::client::get("http://127.0.0.1:8080/hello");
//
// https is `net::tls` under the same message logic: the client speaks it for `https://`
// URLs (verified against the OS trust store, port 443 by default), and a server that
// holds certificates serves it via `server::serve_tls`. Everything between the socket
// and the parse is shared — `Conn` below is the one seam where transport is decided.
// Bodies are fully buffered both ways (streaming is a later shape), requests are served
// one at a time per connection (a pipelined client's extra bytes are carried to the next
// parse, never dropped), and chunked transfer-encoding is DECODED on receipt — llhttp
// does it — while responses are always sent with Content-Length.
//
// The server's `handler` crosses to each connection's fiber, so it must be a NAMED
// function or a capture-free lambda — `tcp::serve`'s rule, for the same reason. State
// belongs in a channel the handler talks to.

use std::fiber;
use std::io::IoError;
use std::list;
use std::net;
use std::string;

/// A parse or protocol failure — malformed bytes, a connection closing mid-message, a URL
/// scheme this module cannot speak. IO failures stay `IoError`; TLS failures (a
/// certificate that would not verify) stay `net::TlsError`.
record HttpError { message: str }
impl Error for HttpError { fn message(v: HttpError) -> str { v.message } }

/// A request method. The standard verbs are atoms — typo-proof and self-documenting, so
/// `:get` cannot be misspelled `"GET "` or lower-cased into a rejection the way a bare
/// string can. An extension method (WebDAV's PROPFIND, a private verb) rides as a raw
/// `str`, passed to the wire verbatim because those ARE case-sensitive tokens the library
/// has no business normalising. The received side (`Request.method`) stays a plain `str`:
/// it is arbitrary data off the wire, and a server must see an unknown verb as it came.
type Method = :get | :post | :put | :delete | :head | :options | :patch | str

/// The wire token for a method: the canonical uppercase spelling for a known verb, the
/// raw string untouched for an extension.
fn method_token(m: Method) -> str {
    if m is str { m }
    else if m == :get { "GET" }
    else if m == :post { "POST" }
    else if m == :put { "PUT" }
    else if m == :delete { "DELETE" }
    else if m == :head { "HEAD" }
    else if m == :options { "OPTIONS" }
    else { "PATCH" }
}

record Request { method: str, target: str, headers: List[(str, str)], body: str }
record Response { status: i64, headers: List[(str, str)], body: str }

/// The llhttp accumulator (see `runtime/include/neon/http.h`). Fiber-local by design: the
/// CONNECTION crosses fibers, and whichever fiber reads it makes the parser.
@runtime("neon_http_parser") sealed opaque record Parser {}

internal mod raw {
    @native("neon_http_parser_new") fn new(response: bool) -> Parser
    /// (code, consumed): 0 = need more (all consumed), 1 = complete (bytes after the
    /// message are NOT consumed), 2 = error (`error` names it).
    @native("neon_http_parser_feed") fn feed(p: Parser, data: str) -> (i64, i64)
    @native("neon_http_parser_finish") fn finish(p: Parser) -> i64
    @native("neon_http_parser_method") fn method(p: Parser) -> str
    @native("neon_http_parser_target") fn target(p: Parser) -> str
    @native("neon_http_parser_status") fn status(p: Parser) -> i64
    @native("neon_http_parser_body") fn body(p: Parser) -> str
    @native("neon_http_parser_keep_alive") fn keep_alive(p: Parser) -> bool
    @native("neon_http_parser_header_count") fn header_count(p: Parser) -> i64
    @native("neon_http_parser_header_at") fn header_at(p: Parser, i: i64) -> (str, str)
    @native("neon_http_parser_error") fn error(p: Parser) -> str
    @native("neon_http_parser_reset") fn reset(p: Parser)
}

// ---- shared: the transport seam, and reading one message off a stream ----

/// The one place transport is decided. Everything HTTP does between the socket and the
/// parser — read_message, the serialisers, a connection's whole life — is written against
/// this union, so plain and TLS connections share every line of message logic and differ
/// only in the three dispatchers below.
type Conn = net::tcp::Stream | net::tls::Stream

fn conn_read(c: Conn, max: i64) throws IoError | net::TlsError -> str {
    match c {
        is net::tcp::Stream => try net::tcp::read(c, max),
        is net::tls::Stream => try net::tls::read(c, max),
    }
}

fn conn_write(c: Conn, data: str) throws IoError | net::TlsError {
    match c {
        is net::tcp::Stream => try net::tcp::write(c, data),
        is net::tls::Stream => try net::tls::write(c, data),
    };
}

fn conn_close(c: Conn) throws IoError {
    match c {
        is net::tcp::Stream => try net::tcp::close(c),
        is net::tls::Stream => try net::tls::close(c),
    };
}

/// Feed bytes until the parser completes a message. `pending` is what a previous parse
/// left unconsumed (a pipelined follow-up); the return is what THIS parse leaves. EOF
/// mid-message is an error unless `finish` says the message legally ends at EOF (a
/// response body delimited by connection close).
fn read_message(c: Conn, p: Parser, pending: str) throws HttpError | IoError | net::TlsError -> str {
    let buf = pending;
    while true {
        if buf != "" {
            let (code, used) = raw::feed(p, buf);
            if code == 2 {
                throw HttpError { message: "bad message: #{raw::error(p)}" };
            };
            if code == 1 {
                return try! string::slice(buf, used, string::byte_len(buf));
            };
            buf = "";
        } else {
            let data = try conn_read(c, 65536);
            if data == "" {
                if raw::finish(p) == 1 {
                    return "";
                };
                throw HttpError { message: "connection closed mid-message" };
            };
            buf = data;
        };
    };
    "" // unreachable: the loop returns or throws
}

fn collect_headers(p: Parser) -> List[(str, str)] {
    let out: List[(str, str)] = [];
    let n = raw::header_count(p);
    let i = 0;
    while i < n {
        out = list::push(out, raw::header_at(p, i));
        i = i + 1;
    };
    out
}

/// The first header with this name, case-insensitively (HTTP field names are), or null.
fn header(headers: List[(str, str)], name: str) -> str | null {
    let want = string::to_lower(name);
    let i = 0;
    while i < list::len(headers) {
        let (f, v) = try! list::get(headers, i);
        if string::to_lower(f) == want {
            return v;
        };
        i = i + 1;
    };
    null
}

// ---- serialisation ----

fn serialize_headers(headers: List[(str, str)], body: str) -> str {
    let out = "";
    let i = 0;
    while i < list::len(headers) {
        let (f, v) = try! list::get(headers, i);
        out = string::concat(out, "#{f}: #{v}\r\n");
        i = i + 1;
    };
    // Content-Length always: responses and requests both frame their body with it, so no
    // peer ever has to wait for a close to know the message ended.
    string::concat(out, "Content-Length: #{string::byte_len(body)}\r\n\r\n#{body}")
}

/// The reason phrase for the status line. RFC 7230 lets it be empty; the common ones are
/// spelled for logs and humans.
fn reason(status: i64) -> str {
    if status == 200 { "OK" }
    else if status == 201 { "Created" }
    else if status == 204 { "No Content" }
    else if status == 301 { "Moved Permanently" }
    else if status == 302 { "Found" }
    else if status == 304 { "Not Modified" }
    else if status == 400 { "Bad Request" }
    else if status == 403 { "Forbidden" }
    else if status == 404 { "Not Found" }
    else if status == 405 { "Method Not Allowed" }
    else if status == 500 { "Internal Server Error" }
    else if status == 501 { "Not Implemented" }
    else { "" }
}

// ---- the server ----

mod server {
    use std::fiber;
    use std::io::IoError;
    use std::net;
    use std::string;

/// A 200 with a text body — the shape most handlers return.
fn ok(body: str) -> Response {
    Response { status: 200, headers: [], body: body }
}

/// A response with the given status and a text body.
fn respond(status: i64, body: str) -> Response {
    Response { status: status, headers: [], body: body }
}

/// Serve forever: one fiber per connection (`move` hands each accepted socket to its
/// fiber), requests parsed and answered in order per connection, keep-alive honoured.
/// A handler's throw becomes a 500 carrying the error's message; a client that sends
/// garbage gets a 400 and the connection closes. Returns only by throwing, hence `never`.
fn serve(l: net::tcp::Listener, handler: (Request) throws HttpError -> Response) throws IoError -> never {
    while true {
        let c = try net::tcp::accept(l);
        fiber::spawn(move () => { connection(c, handler); });
    };
    throw IoError { message: "unreachable: the accept loop ended without failing" }
}

/// As `serve`, over TLS: the listener carries the certificates (`net::tls::listen`), and
/// each accept completes the handshake before its connection fiber is born. A client that
/// fails its handshake — a scanner, a plain-HTTP misdial — ends only that accept, not the
/// server: its TlsError is swallowed here and the loop goes around, which is the same
/// stance `connection` takes toward one peer's garbage.
fn serve_tls(l: net::tls::Listener, handler: (Request) throws HttpError -> Response) throws IoError -> never {
    while true {
        let c = try net::tls::accept(l) catch (e) {
            if e is IoError {
                throw e
            };
            continue
        };
        fiber::spawn(move () => { connection(c, handler); });
    };
    throw IoError { message: "unreachable: the accept loop ended without failing" }
}

/// One connection's whole life, on either transport. Errors end the connection rather
/// than the server: IO failures mean the peer is gone (nothing to tell them), parse
/// failures get a best-effort 400. `try?` softens the goodbye writes — a peer that
/// vanished mid-farewell is fine.
fn connection(c: Conn, handler: (Request) throws HttpError -> Response) {
    let p = raw::new(false);
    let pending = "";
    while true {
        let leftover = try read_message(c, p, pending) catch (e) {
            try? conn_write(c, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n");
            try? conn_close(c);
            return
        };
        pending = leftover;
        let req = Request {
            method: raw::method(p),
            target: raw::target(p),
            headers: collect_headers(p),
            body: raw::body(p),
        };
        let keep = raw::keep_alive(p);
        let resp = try handler(req) catch (e) {
            Response { status: 500, headers: [], body: e.message }
        };
        let head = "HTTP/1.1 #{resp.status} #{reason(resp.status)}\r\n";
        try conn_write(c, string::concat(head, serialize_headers(resp.headers, resp.body))) catch (e) {
            try? conn_close(c);
            return
        };
        if !keep {
            try? conn_close(c);
            return;
        };
        raw::reset(p);
    };
}
}

// ---- the client ----

mod client {
    use std::io::IoError;
    use std::list;
    use std::net;
    use std::string;
    use std::url;

/// A URL split at the syscall boundary's shape: an address for the connect, the raw
/// request-target (path + query, still percent-encoded — the wire wants them that way),
/// the bare host (what TLS verifies and SNI announces — the certificate names a host,
/// never a host:port), and whether the scheme asks for TLS. RFC 3986 parsing is
/// `std::url`'s; the HTTP judgments (scheme, default port, empty path means "/") are
/// this module's.
fn split_url(u: str) throws HttpError -> (str, str, str, bool) {
    let parsed = try url::parse(u) catch (e) {
        throw HttpError { message: e.message };
    };
    if parsed.scheme != "http" and parsed.scheme != "https" {
        throw HttpError { message: "only http:// and https:// URLs are supported: `#{u}`" };
    };
    let secure = parsed.scheme == "https";
    if parsed.host == "" {
        throw HttpError { message: "no host in `#{u}`" };
    };
    let port = if parsed.port == -1 { if secure { 443 } else { 80 } } else { parsed.port };
    let path = if parsed.path == "" { "/" } else { parsed.path };
    let target = if parsed.query == "" { path } else { "#{path}?#{parsed.query}" };
    ("#{parsed.host}:#{port}", target, parsed.host, secure)
}

/// One request, one connection: connect (with the TLS handshake when the URL says
/// https), send, read the full response, close. The `Connection: close` header means an
/// EOF-delimited body parses too (`finish`).
fn request(method: Method, url: str, headers: List[(str, str)], body: str) throws HttpError | IoError | net::TlsError -> Response {
    let (addr, target, host, secure) = try split_url(url);
    let c: Conn = if secure {
        try net::tls::connect(addr, host)
    } else {
        try net::tcp::connect(addr)
    };
    let head = "#{method_token(method)} #{target} HTTP/1.1\r\nHost: #{addr}\r\nConnection: close\r\n";
    try conn_write(c, string::concat(head, serialize_headers(headers, body)));
    let p = raw::new(true);
    try read_message(c, p, "");
    let resp = Response {
        status: raw::status(p),
        headers: collect_headers(p),
        body: raw::body(p),
    };
    try? conn_close(c);
    resp
}

fn get(url: str) throws HttpError | IoError | net::TlsError -> Response {
    try request(:get, url, [], "")
}

fn post(url: str, body: str) throws HttpError | IoError | net::TlsError -> Response {
    try request(:post, url, [], body)
}

// ---- the request builder ----
//
// For anything past a bare get/post: a method, headers, a body, built up and then sent.
// Neon has no method-call syntax, so it threads through the pipe — each step takes the
// request-so-far as its first argument and returns a fresh one (no `mut`; the update form
// rebuilds with one field changed), and `send` is the terminal that actually goes to the
// network:
//
//     let resp = client::new()
//         |> client::url("https://api.example.com/things")
//         |> client::method(:post)
//         |> client::header("Authorization", "Bearer #{token}")
//         |> client::header("Content-Type", "application/json")
//         |> client::body("{\"name\":\"x\"}")
//         |> try! client::send();
//
// Headers accumulate in call order and are sent in that order; nothing dedups or
// normalises them, because a request may legitimately repeat a field and the wire order
// is occasionally load-bearing. `Content-Length` is still added by `send` — don't set it
// by hand. A `send` with no `url` set throws, rather than the URL parser's less obvious
// complaint about the empty string.

record Req {
    url: str,
    method: Method,
    headers: List[(str, str)],
    body: str,
}

/// A blank request: GET, no url, no headers, empty body. Set what you need through the
/// pipe; `url` is the one thing `send` requires.
fn new() -> Req {
    Req { url: "", method: :get, headers: [], body: "" }
}

/// The target URL. `http://` or `https://`; the scheme picks the transport.
fn url(r: Req, u: str) -> Req {
    Req { url: u, ..r }
}

/// The method: an atom for a standard verb (`:post`, `:put`, ...) or a raw string for an
/// extension method.
fn method(r: Req, m: Method) -> Req {
    Req { method: m, ..r }
}

/// Append a header. Repeatable — two calls with the same name send two fields, in order.
fn header(r: Req, name: str, value: str) -> Req {
    Req { headers: list::push(r.headers, (name, value)), ..r }
}

/// The request body. `send` frames it with `Content-Length`, so a body implies no
/// chunked encoding on the way out.
fn body(r: Req, b: str) -> Req {
    Req { body: b, ..r }
}

/// Send the built request and read the full response. The terminal of the pipe.
fn send(r: Req) throws HttpError | IoError | net::TlsError -> Response {
    if r.url == "" {
        throw HttpError { message: "request has no url; set one with `client::url(..)`" };
    };
    try request(r.method, r.url, r.headers, r.body)
}
}
