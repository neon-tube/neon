// `add_millis` and `diff_millis` stay on the integer-millis line and let the civil
// conversion carry every boundary — a year end, a month end, a leap day — so the test is
// exactly those boundaries. One millisecond is enough to cross a year; one day (86_400_000)
// lands on the far side of February in a leap year and a common one.

use std::io;
use std::time;

const DAY: i64 = 86400000

fn at(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, ms: i64) -> time::DateTime {
    time::DateTime { year: y, month: mo, day: d, hour: h, minute: mi, second: s, millis: ms }
}

fn plus(dt: time::DateTime, ms: i64) {
    io::println(time::format_iso(time::add_millis(dt, ms)));
}

fn main() {
    plus(at(2025, 12, 31, 23, 59, 59, 999), 1);   // year rolls over
    plus(at(2026, 1, 31, 0, 0, 0, 0), DAY);        // Jan 31 -> Feb 1
    plus(at(2020, 2, 28, 0, 0, 0, 0), DAY);        // leap year: Feb 28 -> Feb 29
    plus(at(2020, 2, 29, 0, 0, 0, 0), DAY);        // Feb 29 -> Mar 1
    plus(at(2021, 2, 28, 0, 0, 0, 0), DAY);        // common year: Feb 28 -> Mar 1
    plus(at(2026, 1, 1, 0, 0, 0, 0), -1);          // one back crosses to 2025

    // diff is signed: a - b.
    let a = at(2026, 1, 1, 0, 0, 10, 0);
    let b = at(2026, 1, 1, 0, 0, 0, 0);
    io::println("#{time::diff_millis(a, b)}");
    io::println("#{time::diff_millis(b, a)}");
    io::println("#{time::diff_millis(a, a)}");
}
