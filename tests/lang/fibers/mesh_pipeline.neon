use std::fiber::channel;
use std::fiber;
use std::io;
use std::string;

// A three-stage pipeline over two OS THREADS: source → transform → sink, each stage a
// fiber, placement round-robined across the mesh so every hop crosses threads. The output
// order is forced by the DATA (each stage consumes in channel order), so it is
// deterministic no matter how the seats interleave.
fn main() {
    fiber::runtime_on(2, () => {
        let raw: channel::Channel[i64] = channel::new();
        let cooked: channel::Channel[str] = channel::new();
        fiber::spawn(() => {
            loop {
                let v = try channel::recv(cooked) catch (e) { break };
                io::println(v);
            };
            io::println("sink: done");
        });
        fiber::spawn(() => {
            loop {
                let v = try channel::recv(raw) catch (e) { break };
                try! channel::send(cooked, string::concat("cooked-", to_string(v * v)));
            };
            channel::close(cooked);
        });
        fiber::spawn(() => {
            let i = 1;
            while i <= 5 {
                try! channel::send(raw, i);
                i = i + 1;
            }
            channel::close(raw);
        });
    });
    io::println("done");
}
