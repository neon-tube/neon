// The tier-B stdlib additions of 2026-08-09: the by-predicate list queries, the map
// combinators, `split_once`, and `std::encoding`. One program, since each is small and
// they compose — `partition` is `filter` said once, `from_entries` is `entries` reversed.

use std::io;
use std::list;
use std::map;
use std::string;
use std::encoding;

fn main() {
    let xs = [3, 1, 4, 1, 5, 9, 2, 6];

    // Predicate queries: position (first match), count, partition (both halves at once).
    io::println("#{list::position(xs, (x: i64) => x > 4) orelse -1}");
    io::println("#{list::count(xs, (x: i64) => x % 2 == 1)}");
    let (odd, even) = list::partition(xs, (x: i64) => x % 2 == 1);
    io::println("#{odd} #{even}");

    // unique keeps first-seen order; binary_search wants a sorted list.
    io::println("#{list::unique(xs)}");
    io::println("#{list::binary_search([1, 3, 5, 7, 9], 7) orelse -1}");
    io::println("#{list::binary_search([1, 3, 5], 4) orelse -1}");

    // Map combinators: merge (right wins), from_entries (entries' inverse), map_values.
    let m1 = map::new() |> map::set("a", 1) |> map::set("b", 2);
    let m2 = map::new() |> map::set("b", 20) |> map::set("c", 30);
    io::println("#{map::merge(m1, m2)}");
    io::println("#{map::from_entries([("x", 1), ("y", 2)])}");
    io::println("#{map::map_values(m1, (v: i64) => v * 10)}");

    // split_once cuts at the FIRST separator, so the tail keeps its own.
    let cut = string::split_once("key=a=b", "=");
    if cut is (str, str) {
        let (k, v) = cut;
        io::println("#{k} | #{v}");
    };
    io::println("#{string::split_once("nosep", "=") is null}");

    // Encoding: hex and base64, both round-trips and all three base64 tail lengths.
    io::println(encoding::hex_encode("Ab"));
    io::println(try! encoding::hex_decode("4162"));
    io::println("#{encoding::base64_encode("Man")} #{encoding::base64_encode("Ma")} #{encoding::base64_encode("M")}");
    io::println("#{try! encoding::base64_decode("TWFu")} #{try! encoding::base64_decode("TWE=")} #{try! encoding::base64_decode("TQ==")}");
    // Malformed input throws; softened here to null.
    let bad = try? encoding::base64_decode("bad!");
    let odd_hex = try? encoding::hex_decode("abc");
    io::println("#{bad is null} #{odd_hex is null}");
}
