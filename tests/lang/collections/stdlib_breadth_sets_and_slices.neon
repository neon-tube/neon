// The additions of 2026-08-09: `std::set`, the list slicers, map entries, and the
// character-and-float half of `string`. One program, like the other breadth files,
// because the point is composition — `group_by` renders through `Map`'s sorted Display,
// `set` equality is order-independent because the map underneath already was.

use std::io;
use std::list;
use std::map;
use std::set;
use std::string;

fn main() {
    // Sets: membership reading, algebra, and value semantics.
    let s = set::from_list([3, 1, 2, 1, 3]);
    io::println("#{set::len(s)} #{set::contains(s, 2)} #{set::contains(s, 9)}");
    io::println("#{s}");
    let t = set::from_list([2, 3, 4]);
    io::println("#{set::union(s, t)} #{set::intersect(s, t)} #{set::difference(s, t)}");
    io::println("#{set::remove(s, 2)} #{set::len(set::remove(s, 99))}");
    // Two sets built in different orders are the same value.
    io::println("#{set::from_list([1, 2]) == set::from_list([2, 1])}");
    io::println("#{set::is_empty(set::new[i64]())}");

    // enumerate: the index rides with the element.
    let (i1, v1) = list::enumerate(["a", "b"])[1];
    io::println("#{i1} #{v1}");

    // chunks: last one short; windows: all full, so a short list has none.
    io::println("#{list::chunks([1, 2, 3, 4, 5], 2)} #{list::len(list::chunks([1], 0))}");
    io::println("#{list::windows([1, 2, 3, 4], 2)} #{list::len(list::windows([1], 5))}");

    // group_by buckets in encounter order; the rendering sorts the keys.
    let g = list::group_by(["ant", "bee", "ape"], (w: str) => try! string::slice(w, 0, 1));
    io::println("#{g}");

    // entries: the (key, value) shape `for` destructures.
    let es = map::entries(map::new() |> map::set("k", 7));
    let (k, v) = es[0];
    io::println("#{k} #{v}");

    // chars splits at UTF-8 sequence boundaries; byte_len still counts bytes.
    let word = "héllo";
    io::println("#{list::len(string::chars(word))} #{string::byte_len(word)}");
    io::println(string::chars(word)[1]);

    // to_float: strtod's grammar, whole string, no trimming.
    io::println("#{try! string::to_float("1.5e2")} #{try! string::to_float("-0.25")}");
    io::println("#{try? string::to_float("nope") orelse -1.0}");
    io::println("#{try? string::to_float(" 1.0") orelse -1.0}");
}
