// `sign` is the glyph, `signed` forces one onto the number, `pad_int` zero-pads within a
// width that counts the sign, and `percent` scales by 100 and appends `%`. Zero counts as
// non-negative throughout, and padding never truncates.

use std::io;
use std::fmt;

fn show(s: str) { io::println(s); }

fn main() {
    // The sign glyph on its own.
    show(fmt::sign(5));
    show(fmt::sign(-5));
    show(fmt::sign(0));

    // Forced onto the number.
    show(fmt::signed(42));
    show(fmt::signed(-42));
    show(fmt::signed(0));

    // Zero-padding, with the sign counted in the width.
    show(fmt::pad_int(42, 4));
    show(fmt::pad_int(-42, 4));
    show(fmt::pad_int(0, 3));
    show(fmt::pad_int(-1, 5));
    // Already at or over the width: returned unchanged, never truncated.
    show(fmt::pad_int(7, 1));
    show(fmt::pad_int(12345, 3));

    // Percentages: sign and half-to-even rounding come from `fixed`.
    show(fmt::percent(0.1234, 1));
    show(fmt::percent(-0.5, 0));
    show(fmt::percent(1.0, 2));
}
