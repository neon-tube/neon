//@ compile-fail
//@ error-contains: record spread (`..`) is not implemented
//
// `Point { x: 9, ..p }` parses, and the checker fully understands it as an
// update — but no lowering for it exists: the compiler emitted a
// `<todo: record spread>` string constant at the record's repr, and the
// program compiled, ran, and projected fields off a pointer. Until a lowering
// is written the honest answer is this error, not a placeholder value.

use std::io;

type Point = { x: i64, y: i64 }

fn main() {
    let p = Point { x: 1, y: 2 };
    let q = Point { x: 9, ..p };
    io::println("#{q.y}");
}
